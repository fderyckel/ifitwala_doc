{
	"env": {
		"browser": true,
		"node": true,
		"es2022": true
	},
	"parserOptions": {
		"ecmaVersion": 2022,
		"sourceType": "module"
	},
	"extends": [
		"eslint:recommended",
		"plugin:vue/vue3-recommended",
		"plugin:import/recommended",
		"prettier"
	],
	"plugins": ["vue", "import"],
	"rules": {
		"no-console": ["warn", { "allow": ["warn", "error"] }],
		"no-unused-vars": ["warn", { "args": "none", "varsIgnorePattern": "^_" }],
		"vue/multi-word-component-names": "off",
		"import/no-unresolved": "off"
	},
	"globals": {
		"frappe": "readonly"
	},
	"ignorePatterns": [
		"ifitwala_doc/ifitwala_doc/public/dist/**",
		"node_modules/**"
	]
}
