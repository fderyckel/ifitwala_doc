# Root editor config file
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Python uses spaces (ruff-format / PEP 8)
[*.py]
indent_style = space
indent_size = 4
max_line_length = 99

# JS/Vue/CSS/SCSS/HTML use tabs
[{*.js,*.vue,*.css,*.scss,*.html}]
indent_style = tab
indent_size = 2
max_line_length = 99

# JSON files - mostly doctype schema files
[*.json]
insert_final_newline = false
indent_style = space
indent_size = 2
