{
  "name": "ifitwala_doc",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .astro ifitwala_doc/public/dist",
    "dev:marketing": "vite",
    "dev:docs": "node scripts/pull_theme_tokens.mjs --silent || true && astro dev",
    "build:marketing": "vite build",
    "build:docs": "node scripts/pull_theme_tokens.mjs && astro build",
    "build": "npm run clean && npm run build:marketing && npm run build:docs",
    "preview": "vite preview",
    "build:docs-index": "python3 scripts/build_docs_index.py || true"
  },
  "dependencies": {
    "frappe-ui": "^0.1.201",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@astrojs/tailwind": "^6.0.2",
    "@iconify-json/lucide": "^1.2.69",
    "@lucide/astro": "^0.552.0",
    "@tailwindcss/typography": "^0.5.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "@astrojs/vue": "^5.0.0",
    "astro": "^5.14.1",
    "autoprefixer": "^10.4.20",
    "marked": "^16.4.0",
    "postcss": "^8.4.47",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.13.0",
    "tailwindcss": "^3.4.13",
    "unplugin-icons": "^22.4.2",
    "vite": "^7.1.9"
  }
}