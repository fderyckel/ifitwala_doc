{
  "name": "ifitwala_doc",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .astro ifitwala_doc/public/dist",
    "dev:marketing": "vite",
    "dev:docs": "node scripts/pull_theme_tokens.mjs --silent || true && astro dev",
    "build:marketing": "vite build",
    "build:docs": "node scripts/pull_theme_tokens.mjs && mkdir -p public/js && cp -f ifitwala_doc/public/js/marketing.js public/js/marketing.js && astro build",
    "build": "yarn clean && yarn build:marketing && yarn build:docs",
    "preview": "vite preview",
    "build:docs-index": "python3 scripts/build_docs_index.py || true"
  },
  "dependencies": {
    "frappe-ui": "^0.1.261",
    "vue": "^3.5.27",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/vue": "^5.1.4",
    "@iconify-json/lucide": "^1.2.87",
    "@lucide/astro": "^0.563.0",
    "@tailwindcss/typography": "^0.5.19",
    "@vitejs/plugin-vue": "^6.0.3",
    "astro": "^5.17.0",
    "autoprefixer": "^10.4.23",
    "marked": "^17.0.1",
    "postcss": "^8.4.49",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^3.13.0",
    "tailwindcss": "^3.4.17",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.1"
  }
}
