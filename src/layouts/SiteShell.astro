---
import '@/styles/global.css'
import { marked } from 'marked'

import type { NavItem, SiteSettings } from '@/lib/siteClient'

const {
  lang = 'en',
  title = 'Ifitwala Ed',
  description = '',
  canonical,
  headerNav = [],
  footerNav = [],
  settings = {},
  bodyClass = '',
}: {
  lang?: string
  title?: string
  description?: string
  canonical?: string
  headerNav?: NavItem[]
  footerNav?: NavItem[]
  settings?: SiteSettings
  bodyClass?: string
} = Astro.props

const siteName = settings?.site_name || 'Ifitwala Ed'
const resolvedTitle = title || siteName
const resolvedDescription = description || settings?.tagline || ''

const siteOrigin = Astro.site ? Astro.site.toString() : 'https://ifitwala.com/'
const canonicalHref =
  canonical && canonical.startsWith('http')
    ? canonical
    : canonical
    ? new URL(canonical.replace(/^\//, ''), siteOrigin).toString()
    : undefined
const footerHtml = settings?.footer_md ? marked.parse(settings.footer_md) : ''
const headerItems = Array.isArray(headerNav) ? headerNav : []
const footerItems = Array.isArray(footerNav) ? footerNav : []
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{resolvedTitle}</title>
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class={`min-h-screen text-ink antialiased ${bodyClass || ''}`}>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto flex w-full flex-col gap-4 px-6 py-5 md:max-w-6xl md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3 text-lg font-semibold text-canopy">
            {settings?.brand_logo ? (
              <img
                src={settings.brand_logo}
                alt={settings.brand_logo_alt || siteName}
                class="h-11 w-auto rounded-xl border border-border bg-white p-1.5 shadow-sm"
              />
            ) : null}
            <span>{siteName}</span>
          </a>

          {headerItems.length > 0 && (
            <nav class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate md:justify-center">
              {headerItems.map((item) => (
                <a
                  href={item.href}
                  target={item.target_blank ? '_blank' : undefined}
                  rel={item.target_blank ? 'noreferrer' : undefined}
                  class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}

          {settings?.primary_cta_label && settings?.primary_cta_url ? (
            <a
              href={settings.primary_cta_url}
              class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-canopy via-leaf to-canopy px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
            >
              {settings.primary_cta_label}
            </a>
          ) : null}
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-border/70 bg-white/90">
        <div class="mx-auto flex w-full flex-col gap-8 px-6 py-10 md:max-w-6xl md:flex-row md:items-start md:justify-between">
          <div class="max-w-sm space-y-4">
            <div class="text-lg font-semibold text-canopy">{siteName}</div>
            {settings?.tagline && <p class="text-sm text-slate">{settings.tagline}</p>}
            {footerHtml && (
              <div class="prose prose-sm prose-neutral" set:html={footerHtml}></div>
            )}
          </div>

          {footerItems.length > 0 && (
            <nav class="grid gap-2 text-sm font-medium text-slate md:text-right">
              {footerItems.map((item) => (
                <a
                  href={item.href}
                  target={item.target_blank ? '_blank' : undefined}
                  rel={item.target_blank ? 'noreferrer' : undefined}
                  class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}
        </div>
        <div class="border-t border-border/70 py-4 text-center text-xs text-slate">
          © {new Date().getFullYear()} {siteName}. All rights reserved.
        </div>
      </footer>
    </div>
  </body>
</html>
