---
---
import { Github, Linkedin, Twitter, Youtube } from '@lucide/astro';
import '@/styles/global.css';
import { marked } from 'marked';
import type { NavItem, SiteSettings } from '@/lib/siteClient';

const {
  lang = 'en',
  title: titleProp = 'Ifitwala Ed',
  description = '',
  canonical,
  headerNav = [],
  footerNav = [],
  settings = {},
  bodyClass = '',
  ogImage,
  ogTitle,
  ogDescription,
  noindex = false,
}: {
  lang?: string;
  title?: string;
  description?: string;
  canonical?: string;
  headerNav?: NavItem[];
  footerNav?: NavItem[];
  settings?: SiteSettings;
  bodyClass?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
} = Astro.props;

const siteName =
  typeof settings?.site_name === 'string' && settings.site_name.trim()
    ? settings.site_name.trim()
    : 'Ifitwala Ed';
const title =
  typeof titleProp === 'string' && titleProp.trim() ? titleProp : siteName;
const resolvedDescription = description || settings?.tagline || '';

const siteOrigin = Astro.site ? Astro.site.toString() : 'https://ifitwala.com/';
const canonicalHref =
  canonical && canonical.startsWith('http')
    ? canonical
    : canonical
    ? new URL(canonical.replace(/^\//, ''), siteOrigin).toString()
    : undefined;
const footerHtml = settings?.footer_md ? marked.parse(settings.footer_md) : '';
const headerItems = Array.isArray(headerNav) ? headerNav : [];
const footerItems = Array.isArray(footerNav) ? footerNav : [];
const renderedSocialLinks = Array.isArray(settings?.social_links)
  ? settings.social_links
      .map((link: any) => ({
        platform: (link?.platform || '').trim(),
        url: (link?.url || '').trim(),
        icon: (link?.icon || '').trim(),
      }))
      .filter((link: any) => link.url)
  : [];

const sameAs = Array.isArray(settings?.social_same_as)
  ? settings.social_same_as.filter(
      (url: any) => typeof url === 'string' && url.trim()
    )
  : [];

// Update iconMap to use the Lucide components you just imported
const iconMap: Record<string, any> = {
  github: Github,
  linkedin: Linkedin,
  twitter: Twitter,
  x: Twitter,
  youtube: Youtube,
};

const normalizeKey = (value: string) => {
  if (!value) return '';
  const normalized = value.trim().toLowerCase();
  const parts = normalized.split(':');
  return parts[parts.length - 1] || normalized;
};

const detectIconKey = (link: any) => {
  const iconKey = normalizeKey(link?.icon || '');
  if (iconKey && iconMap[iconKey]) return iconKey;
  const platformKey = normalizeKey(link?.platform || '');
  if (platformKey && iconMap[platformKey]) return platformKey;
  const url = (link?.url || '').trim().toLowerCase();
  if (!url) return '';
  if (url.includes('github')) return 'github';
  if (url.includes('linkedin')) return 'linkedin';
  if (url.includes('twitter') || url.includes('x.com')) return 'twitter';
  if (url.includes('youtube')) return 'youtube';
  return '';
};

const headerLink = renderedSocialLinks.find(
  (link) => detectIconKey(link) === 'github'
);
const headerIconKey = headerLink ? detectIconKey(headerLink) : '';
const HeaderIconComponent = headerIconKey ? iconMap[headerIconKey] : null;
const footerSocial = renderedSocialLinks.filter((link) => link !== headerLink);

function absoluteUrl(input?: string | null) {
  if (!input || typeof input !== 'string') {
    return undefined;
  }
  try {
    return new URL(input).toString();
  } catch {
    const trimmed = input.trim();
    if (!trimmed) return undefined;
    const base = Astro.site ? Astro.site : new URL('https://ifitwala.com/');
    try {
      return new URL(trimmed.replace(/^\//, ''), base).toString();
    } catch {
      return undefined;
    }
  }
}

const resolvedOgTitle =
  typeof ogTitle === 'string' && ogTitle.trim() ? ogTitle : title;
const resolvedOgDescription = ogDescription || resolvedDescription;
const resolvedOgImage = absoluteUrl(ogImage);
const robots = noindex ? 'noindex, nofollow' : undefined;
---


<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDescription && <meta property="og:description" content={resolvedOgDescription} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta name="twitter:card" content="summary_large_image" />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgTitle && <meta name="twitter:title" content={resolvedOgTitle} />}
    {resolvedOgDescription && <meta name="twitter:description" content={resolvedOgDescription} />}
    {sameAs.length ? (
      <script type="application/ld+json">
        {JSON.stringify({
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": siteName,
          "url": siteOrigin,
          "sameAs": sameAs,
        })}
      </script>
    ) : null}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class={`min-h-screen text-ink antialiased ${bodyClass || ''}`}>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto flex w-full flex-col gap-4 px-6 py-5 md:max-w-6xl md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3 text-lg font-semibold text-canopy">
            {settings?.brand_logo ? (
              <img
                src={settings.brand_logo}
                alt={settings.brand_logo_alt || siteName}
                class="h-11 w-auto rounded-xl border border-border bg-white p-1.5 shadow-sm"
              />
            ) : null}
            <span>{siteName}</span>
          </a>

          {headerItems.length > 0 && (
            <nav class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate md:justify-center">
              {headerItems.map((item) => (
                <a
                  href={item.href}
                  target={item.target_blank ? '_blank' : undefined}
                  rel={item.target_blank ? 'noreferrer' : undefined}
                  class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}

          {headerLink ? (
            <div class="flex items-center gap-2 md:ml-4">
              <a
                href={headerLink.url}
                title={headerLink.platform || headerLink.url}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border/60 bg-white/80 text-canopy transition hover:bg-moss/30 hover:text-canopy"
                target="_blank"
                rel="noreferrer"
              >
                {HeaderIconComponent ? (
                  <HeaderIconComponent class="h-5 w-5" />
                ) : (
                  <span class="text-xs font-semibold uppercase tracking-[0.2em]">{(headerLink.platform || headerLink.url).slice(0,2).toUpperCase()}</span>
                )}
              </a>
            </div>
          ) : null}
          {settings?.primary_cta_label && settings?.primary_cta_url ? (
            <a
              href={settings.primary_cta_url}
              class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-canopy via-leaf to-canopy px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
            >
              {settings.primary_cta_label}
            </a>
          ) : null}
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto w-full px-6 py-6 md:max-w-6xl">
          <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
            <div class="text-lg font-semibold text-canopy">{siteName}</div>
            {footerItems.length > 0 && (
              <nav class="flex flex-wrap items-center gap-4 text-sm font-medium text-slate md:justify-end">
                {footerItems.map((item) => (
                  <a
                    href={item.href}
                    target={item.target_blank ? '_blank' : undefined}
                    rel={item.target_blank ? 'noreferrer' : undefined}
                    class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy"
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            )}
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,2.5fr)_minmax(0,3fr)] md:items-start md:gap-10">
            <div class="space-y-4">
              {settings?.tagline && <p class="text-sm text-slate">{settings.tagline}</p>}
              {footerSocial.length ? (
                <nav class="flex flex-wrap items-center gap-3 text-sm text-slate">
                  {footerSocial.map((link) => (
                    <a
                      href={link.url}
                      title={link.platform || link.url}
                      class="flex h-10 w-10 items-center justify-center rounded-full border border-border/60 bg-white/85 text-canopy transition hover:bg-moss/30 hover:text-canopy"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {(() => {
                        const iconKey = detectIconKey(link)
                        const IconComp = iconKey ? iconMap[iconKey] : null
                        const icon = link.icon || ''
                        if (IconComp) {
                          return <IconComp class="h-5 w-5" />
                        }
                        if (icon.startsWith('http') || icon.startsWith('/')) {
                          return <img src={icon} alt={link.platform || 'social'} class="h-5 w-5" loading="lazy" />
                        }
                        if (icon) {
                          return <span class="text-base font-semibold">{icon}</span>
                        }
                        return <span class="text-xs font-semibold uppercase tracking-[0.2em]">{(link.platform || link.url).slice(0,2).toUpperCase()}</span>
                      })()}
                    </a>
                  ))}
                </nav>
              ) : null}
        </div>
        <div class="border-t border-border/60 py-3 text-center text-xs text-slate">
          © {new Date().getFullYear()} {siteName}. All rights reserved.
        </div>
      </footer>
    </div>
  </body>
</html>
