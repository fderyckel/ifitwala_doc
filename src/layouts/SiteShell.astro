---
import { Github, Linkedin, Twitter, Youtube } from '@lucide/astro';
import '@/styles/global.css';
import { marked } from 'marked';
import type { NavItem, SiteSettings } from '@/lib/siteClient';
import {
  alternateLinks as buildAlternateLinks,
  localeLabels,
  localizeHref,
  localizeNav,
  localizeSettings,
  localizedPath,
  normalizePath,
  normalizeLocale,
  stripLocale,
  type Locale,
} from '@/lib/i18n';
import {
  breadcrumbSchema,
  organizationSchema,
  webPageSchema,
  websiteSchema,
  type JsonLd,
} from '@/lib/seo';

const {
  lang = 'en',
  title: titleProp = 'Ifitwala',
  description = '',
  canonical,
  headerNav = [],
  footerNav = [],
  settings = {},
  bodyClass = '',
  ogImage,
  ogTitle,
  ogDescription,
  noindex = false,
  nofollow = false,
  keywords = '',
  ogType = 'website',
  ogImageAlt,
  structuredData = [],
  availableLocales,
} = Astro.props as {
  lang?: string;
  title?: string;
  description?: string;
  canonical?: string;
  headerNav?: NavItem[];
  footerNav?: NavItem[];
  settings?: SiteSettings;
  bodyClass?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  noindex?: boolean;
  nofollow?: boolean;
  keywords?: string;
  ogType?: string;
  ogImageAlt?: string;
  structuredData?: JsonLd | JsonLd[];
  availableLocales?: string[];
};

const activeLocale = normalizeLocale(lang) as Locale;
const localizedSettings = localizeSettings(settings, activeLocale);
const normalizedAvailableLocales = Array.from(
  new Set(
    (Array.isArray(availableLocales) && availableLocales.length ? availableLocales : [activeLocale])
      .map((locale) => normalizeLocale(locale))
  )
);
if (!normalizedAvailableLocales.includes(activeLocale)) {
  normalizedAvailableLocales.unshift(activeLocale);
}

const siteName =
  typeof localizedSettings?.site_name === 'string' && localizedSettings.site_name.trim()
    ? localizedSettings.site_name.trim()
    : 'Ifitwala';
const title =
  typeof titleProp === 'string' && titleProp.trim() ? titleProp : siteName;
const resolvedDescription = description || localizedSettings?.tagline || '';

const siteOrigin = Astro.site ? Astro.site.toString() : 'https://ifitwala.com/';
const siteRoot = siteOrigin.endsWith('/') ? siteOrigin : `${siteOrigin}/`;
const footerHtml = localizedSettings?.footer_md ? marked.parse(localizedSettings.footer_md) : '';
const headerItems = localizeNav(Array.isArray(headerNav) ? headerNav : [], activeLocale);
const footerItems = localizeNav(Array.isArray(footerNav) ? footerNav : [], activeLocale);
const renderedSocialLinks = Array.isArray(localizedSettings?.social_links)
  ? localizedSettings.social_links
      .map((link: any) => ({
        platform: (link?.platform || '').trim(),
        url: (link?.url || '').trim(),
        icon: (link?.icon || '').trim(),
      }))
      .filter((link: any) => link.url)
  : [];

const sameAs = Array.isArray(localizedSettings?.social_same_as)
  ? localizedSettings.social_same_as.filter(
      (url: any) => typeof url === 'string' && url.trim()
    )
  : [];

// Update iconMap to use the Lucide components you just imported
const iconMap: Record<string, any> = {
  github: Github,
  linkedin: Linkedin,
  twitter: Twitter,
  x: Twitter,
  youtube: Youtube,
};

const normalizeKey = (value: string) => {
  if (!value) return '';
  const normalized = value.trim().toLowerCase();
  const parts = normalized.split(':');
  return parts[parts.length - 1] || normalized;
};

const detectIconKey = (link: any) => {
  const iconKey = normalizeKey(link?.icon || '');
  if (iconKey && iconMap[iconKey]) return iconKey;
  const platformKey = normalizeKey(link?.platform || '');
  if (platformKey && iconMap[platformKey]) return platformKey;
  const url = (link?.url || '').trim().toLowerCase();
  if (!url) return '';
  if (url.includes('github')) return 'github';
  if (url.includes('linkedin')) return 'linkedin';
  if (url.includes('twitter') || url.includes('x.com')) return 'twitter';
  if (url.includes('youtube')) return 'youtube';
  return '';
};

const headerLink = renderedSocialLinks.find(
  (link) => detectIconKey(link) === 'github'
);
const headerIconKey = headerLink ? detectIconKey(headerLink) : '';
const HeaderIconComponent = headerIconKey ? iconMap[headerIconKey] : null;
const footerSocial = renderedSocialLinks.filter((link) => link !== headerLink);

const rawPrimaryCtaLabel =
  typeof localizedSettings?.primary_cta_label === 'string' && localizedSettings.primary_cta_label.trim()
    ? localizedSettings.primary_cta_label.trim()
    : 'Book a Call';
const rawPrimaryCtaUrl =
  typeof localizedSettings?.primary_cta_url === 'string' && localizedSettings.primary_cta_url.trim()
    ? localizedSettings.primary_cta_url.trim()
    : '/book-a-call/';
const primaryCtaLooksProductOnly = rawPrimaryCtaLabel.toLowerCase().includes('demo');
const primaryCtaLooksVague = rawPrimaryCtaLabel.toLowerCase() === 'explore for more';
const fitCallLabel = activeLocale === 'fr' ? 'Appel de cadrage' : 'Book a fit call';
const primaryCtaLabel = primaryCtaLooksProductOnly || primaryCtaLooksVague ? fitCallLabel : rawPrimaryCtaLabel;
const primaryCtaUrl =
  primaryCtaLooksProductOnly || primaryCtaLooksVague || rawPrimaryCtaUrl.replace(/\/+$/, '') === '/book-a-demo'
    ? localizeHref('/book-a-call/', activeLocale)
    : rawPrimaryCtaUrl;

function absoluteUrl(input?: string | null) {
  if (!input || typeof input !== 'string') {
    return undefined;
  }
  try {
    return new URL(input).toString();
  } catch {
    const trimmed = input.trim();
    if (!trimmed) return undefined;
    const base = Astro.site ? Astro.site : new URL('https://ifitwala.com/');
    try {
      return new URL(trimmed.replace(/^\//, ''), base).toString();
    } catch {
      return undefined;
    }
  }
}

const resolvedOgTitle =
  typeof ogTitle === 'string' && ogTitle.trim() ? ogTitle : title;
const resolvedOgDescription = ogDescription || resolvedDescription;
const resolvedOgImage = absoluteUrl(ogImage);
const resolvedOgImageAlt =
  typeof ogImageAlt === 'string' && ogImageAlt.trim()
    ? ogImageAlt.trim()
    : undefined;
const resolvedOgType =
  typeof ogType === 'string' && ogType.trim() ? ogType.trim() : 'website';

let robots = 'index, follow, max-image-preview:large';
if (noindex || nofollow) {
  const directives: string[] = [];
  directives.push(noindex ? 'noindex' : 'index');
  directives.push(nofollow ? 'nofollow' : 'follow');
  robots = directives.join(', ');
}

const currentPath = canonical || Astro.url.pathname || '/';
const shouldLocalizePage = normalizedAvailableLocales.length > 1;
const canonicalPath = shouldLocalizePage
  ? localizeHref(stripLocale(currentPath), activeLocale)
  : normalizePath(stripLocale(currentPath));
const localizedCanonical =
  canonical && canonical.startsWith('http')
    ? canonical
    : new URL(canonicalPath.replace(/^\//, ''), siteRoot).toString();
const localizedAlternateLinks =
  normalizedAvailableLocales.length > 1
    ? buildAlternateLinks(currentPath, normalizedAvailableLocales).map((link) => ({
        ...link,
        href: new URL(link.href.replace(/^\//, ''), siteRoot).toString(),
      }))
    : [];
const localeSwitcherItems = normalizedAvailableLocales.length > 1 ? normalizedAvailableLocales : [];

const providedStructuredData = (Array.isArray(structuredData) ? structuredData : [structuredData]).filter(
  (item): item is JsonLd => Boolean(item) && typeof item === 'object'
);
const graph = [
  organizationSchema(siteName, localizedSettings?.brand_logo, sameAs),
  websiteSchema(siteName),
  webPageSchema({
    url: localizedCanonical,
    name: title,
    description: resolvedDescription,
    inLanguage: activeLocale,
  }),
  breadcrumbSchema(localizedCanonical),
  ...providedStructuredData,
].filter(Boolean);
const graphSchema = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
const homeHref = shouldLocalizePage ? localizedPath('/', activeLocale) : '/';
---


<html lang={activeLocale}>
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}
    {keywords && <meta name="keywords" content={keywords} />}
    {localizedCanonical && <link rel="canonical" href={localizedCanonical} />}
    {localizedAlternateLinks.map((link) => (
      <link rel="alternate" hreflang={link.hreflang} href={link.href} />
    ))}
    {robots && <meta name="robots" content={robots} />}
    <meta name="author" content={siteName} />
    <meta name="application-name" content={siteName} />
    <meta name="theme-color" content="#12563A" />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:site_name" content={siteName} />
    {localizedCanonical && <meta property="og:url" content={localizedCanonical} />}
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDescription && <meta property="og:description" content={resolvedOgDescription} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImageAlt && <meta property="og:image:alt" content={resolvedOgImageAlt} />}
    <meta name="twitter:card" content={resolvedOgImage ? 'summary_large_image' : 'summary'} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgTitle && <meta name="twitter:title" content={resolvedOgTitle} />}
    {resolvedOgDescription && <meta name="twitter:description" content={resolvedOgDescription} />}
    <script type="application/ld+json" set:html={JSON.stringify(graphSchema)} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class={`min-h-screen text-ink antialiased ${bodyClass || ''}`}>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto flex w-full flex-col gap-4 px-6 py-5 md:max-w-6xl md:flex-row md:items-center md:justify-between">
          <a href={homeHref} class="flex items-center gap-3 text-lg font-semibold text-canopy">
            {localizedSettings?.brand_logo ? (
              <img
                src={localizedSettings.brand_logo}
                alt={localizedSettings.brand_logo_alt || siteName}
                class="h-11 w-auto rounded-xl border border-border bg-white p-1.5 shadow-sm"
              />
            ) : null}
            <span>{siteName}</span>
          </a>

          {headerItems.length > 0 && (
            <nav class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate md:justify-center">
              {headerItems.map((item) => (
                <a
                  href={item.href}
                  target={item.target_blank ? '_blank' : undefined}
                  rel={item.target_blank ? 'noreferrer' : undefined}
                  class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}

          {headerLink ? (
            <div class="flex items-center gap-2 md:ml-4">
              <a
                href={headerLink.url}
                title={headerLink.platform || headerLink.url}
                class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-border/60 bg-white/80 text-canopy transition hover:bg-moss/30 hover:text-canopy"
                target="_blank"
                rel="noreferrer"
              >
                {HeaderIconComponent ? (
                  <HeaderIconComponent class="h-5 w-5" />
                ) : (
                  <span class="text-xs font-semibold uppercase tracking-[0.2em]">{(headerLink.platform || headerLink.url).slice(0,2).toUpperCase()}</span>
                )}
              </a>
            </div>
          ) : null}
          <div class="flex flex-wrap items-center gap-2">
            {localeSwitcherItems.length > 1 ? (
            <div class="inline-flex rounded-md border border-border/70 bg-white/75 p-1 text-xs font-semibold text-slate">
              {localeSwitcherItems.map((locale) => (
                <a
                  href={localizedPath(stripLocale(Astro.url.pathname), locale)}
                  class={`rounded px-2.5 py-1 transition ${
                    locale === activeLocale ? 'bg-canopy text-white' : 'hover:bg-moss/40 hover:text-canopy'
                  }`}
                  aria-current={locale === activeLocale ? 'page' : undefined}
                >
                  {localeLabels[locale]}
                </a>
              ))}
            </div>
            ) : null}
            {primaryCtaLabel && primaryCtaUrl ? (
              <a
                href={primaryCtaUrl}
                class="inline-flex items-center justify-center rounded-md bg-canopy px-5 py-2.5 text-sm font-semibold text-white shadow-soft transition hover:bg-[#0f4a31] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
              >
                {primaryCtaLabel}
              </a>
            ) : null}
          </div>
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto w-full px-6 py-6 md:max-w-6xl">
          <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
            <div class="text-lg font-semibold text-canopy">{siteName}</div>
            {footerItems.length > 0 && (
              <nav class="flex flex-wrap items-center gap-4 text-sm font-medium text-slate md:justify-end">
                {footerItems.map((item) => (
                  <a
                    href={item.href}
                    target={item.target_blank ? '_blank' : undefined}
                    rel={item.target_blank ? 'noreferrer' : undefined}
                    class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy"
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            )}
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,2.5fr)_minmax(0,3fr)] md:items-start md:gap-10">
            <div class="space-y-4">
              {localizedSettings?.tagline && <p class="text-sm text-slate">{localizedSettings.tagline}</p>}
              {footerSocial.length ? (
                <nav class="flex flex-wrap items-center gap-3 text-sm text-slate">
                  {footerSocial.map((link) => (
                    <a
                      href={link.url}
                      title={link.platform || link.url}
                      class="flex h-10 w-10 items-center justify-center rounded-full border border-border/60 bg-white/85 text-canopy transition hover:bg-moss/30 hover:text-canopy"
                      target="_blank"
                      rel="noreferrer"
                    >
                      {(() => {
                        const iconKey = detectIconKey(link)
                        const IconComp = iconKey ? iconMap[iconKey] : null
                        const icon = link.icon || ''
                        if (IconComp) {
                          return <IconComp class="h-5 w-5" />
                        }
                        if (icon.startsWith('http') || icon.startsWith('/')) {
                          return <img src={icon} alt={link.platform || 'social'} class="h-5 w-5" loading="lazy" />
                        }
                        if (icon) {
                          return <span class="text-base font-semibold">{icon}</span>
                        }
                        return <span class="text-xs font-semibold uppercase tracking-[0.2em]">{(link.platform || link.url).slice(0,2).toUpperCase()}</span>
                      })()}
                    </a>
                  ))}
                </nav>
              ) : null}
              {footerHtml ? (
                <div class="prose prose-sm max-w-none text-slate" set:html={footerHtml} />
              ) : null}
            </div>
            <div class="border-t border-border/60 py-3 text-center text-xs text-slate md:border-t-0 md:text-right">
              © {new Date().getFullYear()} {siteName}. All rights reserved.
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
