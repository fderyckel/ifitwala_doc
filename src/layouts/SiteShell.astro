---
import '@/styles/global.css'
import { marked } from 'marked'

import type { NavItem, SiteSettings } from '@/lib/siteClient'

const {
  lang = 'en',
  title = 'Ifitwala Ed',
  description = '',
  canonical,
  headerNav = [],
  footerNav = [],
  settings = {},
  bodyClass = '',
  ogImage,
  ogTitle,
  ogDescription,
  noindex = false,
}: {
  lang?: string
  title?: string
  description?: string
  canonical?: string
  headerNav?: NavItem[]
  footerNav?: NavItem[]
  settings?: SiteSettings
  bodyClass?: string
  ogImage?: string
  ogTitle?: string
  ogDescription?: string
  noindex?: boolean
} = Astro.props

const siteName = settings?.site_name || 'Ifitwala Ed'
const resolvedTitle = title || siteName
const resolvedDescription = description || settings?.tagline || ''

const siteOrigin = Astro.site ? Astro.site.toString() : 'https://ifitwala.com/'
const canonicalHref =
  canonical && canonical.startsWith('http')
    ? canonical
    : canonical
    ? new URL(canonical.replace(/^\//, ''), siteOrigin).toString()
    : undefined
const footerHtml = settings?.footer_md ? marked.parse(settings.footer_md) : ''
const headerItems = Array.isArray(headerNav) ? headerNav : []
const footerItems = Array.isArray(footerNav) ? footerNav : []

function absoluteUrl(input?: string | null) {
  if (!input || typeof input !== 'string') {
    return undefined
  }
  try {
    return new URL(input).toString()
  } catch {
    const trimmed = input.trim()
    if (!trimmed) return undefined
    const base = Astro.site ? Astro.site : new URL('https://ifitwala.com/')
    try {
      return new URL(trimmed.replace(/^\//, ''), base).toString()
    } catch {
      return undefined
    }
  }
}

const resolvedOgTitle = ogTitle || resolvedTitle
const resolvedOgDescription = ogDescription || resolvedDescription
const resolvedOgImage = absoluteUrl(ogImage)
const robots = noindex ? 'noindex, nofollow' : undefined
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <title>{resolvedTitle}</title>
    {resolvedDescription && <meta name="description" content={resolvedDescription} />}
    {canonicalHref && <link rel="canonical" href={canonicalHref} />}
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={resolvedOgTitle} />
    {resolvedOgDescription && <meta property="og:description" content={resolvedOgDescription} />}
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    {resolvedOgImage && <meta name="twitter:card" content="summary_large_image" />}
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}
    {resolvedOgTitle && <meta name="twitter:title" content={resolvedOgTitle} />}
    {resolvedOgDescription && <meta name="twitter:description" content={resolvedOgDescription} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class={`min-h-screen text-ink antialiased ${bodyClass || ''}`}>
    <div class="flex min-h-screen flex-col">
      <header class="border-b border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto flex w-full flex-col gap-4 px-6 py-5 md:max-w-6xl md:flex-row md:items-center md:justify-between">
          <a href="/" class="flex items-center gap-3 text-lg font-semibold text-canopy">
            {settings?.brand_logo ? (
              <img
                src={settings.brand_logo}
                alt={settings.brand_logo_alt || siteName}
                class="h-11 w-auto rounded-xl border border-border bg-white p-1.5 shadow-sm"
              />
            ) : null}
            <span>{siteName}</span>
          </a>

          {headerItems.length > 0 && (
            <nav class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate md:justify-center">
              {headerItems.map((item) => (
                <a
                  href={item.href}
                  target={item.target_blank ? '_blank' : undefined}
                  rel={item.target_blank ? 'noreferrer' : undefined}
                  class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
                >
                  {item.label}
                </a>
              ))}
            </nav>
          )}

          {settings?.primary_cta_label && settings?.primary_cta_url ? (
            <a
              href={settings.primary_cta_url}
              class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-canopy via-leaf to-canopy px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50"
            >
              {settings.primary_cta_label}
            </a>
          ) : null}
        </div>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <footer class="mt-16 border-t border-border/60 bg-white/85 backdrop-blur">
        <div class="mx-auto w-full px-6 py-6 md:max-w-6xl">
          <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
            <div class="text-lg font-semibold text-canopy">{siteName}</div>
            {footerItems.length > 0 && (
              <nav class="flex flex-wrap items-center gap-4 text-sm font-medium text-slate md:justify-end">
                {footerItems.map((item) => (
                  <a
                    href={item.href}
                    target={item.target_blank ? '_blank' : undefined}
                    rel={item.target_blank ? 'noreferrer' : undefined}
                    class="rounded-full px-3 py-2 transition hover:bg-moss/40 hover:text-canopy"
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            )}
          </div>

          <div class="mt-6 grid gap-6 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] md:items-start md:gap-10">
            {settings?.tagline && <p class="text-sm text-slate">{settings.tagline}</p>}
            {footerHtml && (
              <div class="prose prose-sm prose-neutral md:justify-self-end" set:html={footerHtml}></div>
            )}
          </div>
        </div>
        <div class="border-t border-border/60 py-3 text-center text-xs text-slate">
          © {new Date().getFullYear()} {siteName}. All rights reserved.
        </div>
      </footer>
    </div>
  </body>
</html>
