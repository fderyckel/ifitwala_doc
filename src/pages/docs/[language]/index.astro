---
import DocsShell from '@/layouts/DocsShell.astro'
import { getCategories, getAvailableLanguages } from '@/lib/docsClient'

const LANGUAGE_CODE_RX = /^[a-z]{2}$/i

export const prerender = true

export async function getStaticPaths() {
  const languages = await getAvailableLanguages()
  return languages.map((language) => ({ params: { language } }))
}

const languageParam = typeof Astro.params.language === 'string' ? Astro.params.language : ''
const language = LANGUAGE_CODE_RX.test(languageParam || '') ? languageParam.toLowerCase() : 'en'
let categories = []
try {
  categories = await getCategories(language)
} catch {
  categories = []
}

const ICON_PATHS = {
  book: 'M4 19.5V6.75A2.25 2.25 0 016.25 4.5h11.5m-13.75 15A2.25 2.25 0 006.25 21h11.5m-13.75-1.5h13.5m0-15A2.25 2.25 0 0121 6.75V21M6.75 7.5h6',
  users:'M16 14a4 4 0 10-8 0m-5 6a7 7 0 0114 0M12 8a4 4 0 110-8 4 4 0 010 8',
  check:'M4.5 12.75l6 6 9-13.5',
  beaker:'M9 2.25h6M9 2.25v5.25L4.5 15.75A6 6 0 0010.5 21h3a6 6 0 006-5.25L15 7.5V2.25',
  calendar:'M6 8h12M7 4v4m10-4v4M6 20h12a2 2 0 002-2V8H4v10a2 2 0 002 2',
}

const title = `Documentation — ${language.toUpperCase()}`
---

<DocsShell lang={language} title={title}>
  <main class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="text-3xl font-bold tracking-tight">Documentation — {language}</h1>
    <p class="text-slate mt-2">Pick a category below.</p>

    {categories?.length ? (
      <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {categories.map((c) => (
          <a
            href={`/docs/${language}/${c.slug}/`}
            class="group block bg-white border rounded-2xl p-6 hover:shadow-lg transition"
          >
            <div class="h-1 w-10 rounded bg-brand-600 mb-4 opacity-90 group-hover:opacity-100"></div>
            <div class="flex items-start gap-3">
              {c.icon && (ICON_PATHS[(c.icon || '').toLowerCase()] ? (
                <svg
                  viewBox="0 0 24 24"
                  class="w-6 h-6 opacity-80"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d={ICON_PATHS[(c.icon || '').toLowerCase()]} />
                </svg>
              ) : <span class="text-xl">{c.icon}</span>)}
              <div>
                <div class="text-lg font-semibold group-hover:text-brand-700">{c.label}</div>
                {c.description && <p class="text-sm text-slate mt-1">{c.description}</p>}
              </div>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <p class="text-slate mt-6">No categories yet.</p>
    )}
  </main>
</DocsShell>
