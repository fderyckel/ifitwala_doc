---
import DocsShell from '@/layouts/DocsShell.astro'
import { getCategories, getAvailableLanguages } from '@/lib/docsClient'
import { describeLanguage } from '@/lib/language'

export const prerender = true

export async function getStaticPaths() {
  const languages = await getAvailableLanguages()
  const seen = new Set<string>()
  const paths = []
  for (const language of languages) {
    const info = describeLanguage(language)
    if (!info.raw || !info.slug) {
      continue
    }
    if (seen.has(info.slug)) {
      continue
    }
    seen.add(info.slug)
    paths.push({
      params: { language: info.slug },
      props: { languageRaw: info.raw, languageSlug: info.slug },
    })
  }
  return paths
}

const props = (Astro.props ?? {}) as Record<string, unknown>
const languageParam = typeof Astro.params.language === 'string' ? Astro.params.language : ''
const propLanguageRaw = typeof props.languageRaw === 'string' ? props.languageRaw : ''
const propLanguageSlug = typeof props.languageSlug === 'string' ? props.languageSlug : ''

const languageInfo = describeLanguage(propLanguageRaw || languageParam)
const languageRaw = languageInfo.raw || 'en'
const languageSlug = propLanguageSlug || languageInfo.slug || 'en'
let categories = []
try {
  categories = await getCategories(languageRaw)
} catch {
  categories = []
}

const ICON_PATHS = {
  book: 'M4 19.5V6.75A2.25 2.25 0 016.25 4.5h11.5m-13.75 15A2.25 2.25 0 006.25 21h11.5m-13.75-1.5h13.5m0-15A2.25 2.25 0 0121 6.75V21M6.75 7.5h6',
  users:'M16 14a4 4 0 10-8 0m-5 6a7 7 0 0114 0M12 8a4 4 0 110-8 4 4 0 010 8',
  check:'M4.5 12.75l6 6 9-13.5',
  beaker:'M9 2.25h6M9 2.25v5.25L4.5 15.75A6 6 0 0010.5 21h3a6 6 0 006-5.25L15 7.5V2.25',
  calendar:'M6 8h12M7 4v4m10-4v4M6 20h12a2 2 0 002-2V8H4v10a2 2 0 002 2',
}

function normalizeIconSource(raw: unknown) {
  if (typeof raw !== 'string') return null
  const value = raw.trim()
  if (!value) return null
  const isImage =
    /^(https?:|data:|\/)/i.test(value) ||
    value.toLowerCase().endsWith('.svg') ||
    value.toLowerCase().endsWith('.png') ||
    value.toLowerCase().endsWith('.jpg') ||
    value.toLowerCase().endsWith('.jpeg') ||
    value.toLowerCase().endsWith('.webp')
  return { value, isImage }
}

const title = `Documentation — ${languageRaw}`
---

<DocsShell lang={languageRaw} title={title} description={`Documentation categories for ${languageRaw}`}>
  <main class="mx-auto max-w-6xl px-6 py-12">
    <h1 class="text-3xl font-bold tracking-tight">Documentation — {languageRaw}</h1>
    <p class="text-slate mt-2">Pick a category below.</p>

    {categories?.length ? (
      <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-8">
        {categories.map((c) => (
          <a
            href={`/docs/${languageSlug}/${c.slug}/`}
            class="group block bg-white border border-border/60 rounded-2xl p-6 hover:shadow-lg transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/60"
          >
            <div class="h-1 w-10 rounded bg-leaf mb-4 opacity-90 group-hover:opacity-100"></div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <div class="text-lg font-semibold text-ink group-hover:text-canopy">{c.label}</div>
                {c.description && <p class="text-sm text-slate mt-1">{c.description}</p>}
              </div>
              {(() => {
                const rawIcon = typeof c.icon === 'string' ? c.icon : ''
                const svgPath = ICON_PATHS[rawIcon.trim().toLowerCase()]
                const fallback = svgPath ? null : normalizeIconSource(rawIcon)
                if (svgPath) {
                  return (
                    <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-moss/30 text-canopy">
                      <svg
                        viewBox="0 0 24 24"
                        class="h-7 w-7"
                        aria-hidden="true"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={svgPath} />
                      </svg>
                    </span>
                  )
                }
                if (fallback) {
                  return fallback.isImage ? (
                    <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-moss/20">
                      <img
                        src={fallback.value}
                        alt={`${c.label} icon`}
                        class="h-10 w-10 object-contain"
                        loading="lazy"
                      />
                    </span>
                  ) : (
                    <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-moss/30 text-canopy text-2xl">
                      {fallback.value}
                    </span>
                  )
                }
                return null
              })()}
            </div>
          </a>
        ))}
      </section>
    ) : (
      <p class="text-slate mt-6">No categories yet.</p>
    )}
  </main>
</DocsShell>
