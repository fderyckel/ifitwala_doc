---
// /src/pages/docs/[language]/[category]/index.astro
import { getCategory, getDocsInCategory } from '@/lib/docsClient'

const { language, category } = Astro.params // 'category' is the slug
const cat = await getCategory(category)
const docs = await getDocsInCategory(language, category)

const Icon = ({ icon }: { icon?: string }) => {
  if (!icon) return null
  const key = (icon || '').trim().toLowerCase()

  // map each key to an SVG *path d* value
  const map: Record<string, string> = {
    book:    'M4 19.5V6.75A2.25 2.25 0 016.25 4.5h11.5m-13.75 15A2.25 2.25 0 006.25 21h11.5m-13.75-1.5h13.5m0-15A2.25 2.25 0 0121 6.75V21M6.75 7.5h6',
    users:   'M16 14a4 4 0 10-8 0m-5 6a7 7 0 0114 0M12 8a4 4 0 110-8 4 4 0 010 8',
    check:   'M4.5 12.75l6 6 9-13.5',
    beaker:  'M9 2.25h6M9 2.25v5.25L4.5 15.75A6 6 0 0010.5 21h3a6 6 0 006-5.25L15 7.5V2.25',
    calendar:'M6 8h12M7 4v4m10-4v4M6 20h12a2 2 0 002-2V8H4v10a2 2 0 002 2',
  }

  if (map[key]) {
    // NOTE: use standard attributes (no innerHTML). Path goes in d=…
    return (
      <svg viewBox="0 0 24 24" class="w-6 h-6 opacity-80" fill="none"
           stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d={map[key]} />
      </svg>
    )
  }

  // Fallback: render the provided emoji/text
  return <span class="text-xl">{key}</span>
}
---

<html lang={language || 'en'}>
  <head>
    <meta charset="utf-8" />
    <title>{(cat?.label || category) + ' — Docs (' + (language || 'en') + ') | Ifitwala Ed'}</title>
    <meta name="description" content={cat?.description || 'Category'} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-panel text-ink">
    <main class="mx-auto max-w-6xl px-6 py-10">
      <nav class="text-sm text-slate mb-4">
        <a class="hover:underline" href="/docs/">Docs</a>
        <span class="mx-1">›</span>
        <span>{cat?.label || category}</span>
      </nav>

      <header class="mb-6">
        <h1 class="text-2xl font-bold flex items-center gap-2">
          <Icon icon={cat?.icon} />
          <span>{cat?.label || category}</span>
        </h1>
        {cat?.description && <p class="text-slate mt-1">{cat.description}</p>}
      </header>

      {docs?.length ? (
        <ul class="grid sm:grid-cols-2 gap-4">
          {docs.map((d:any) => (
            <li>
              <a
                href={`/docs/${language}/${d.slug}`}
                class="block bg-white border rounded-2xl p-5 hover:shadow-lg transition"
              >
                <div class="font-semibold">{d.title}</div>
                {d.summary && <div class="text-sm text-slate mt-1">{d.summary}</div>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <div class="text-slate">No documents in this category yet.</div>
      )}
    </main>
  </body>
</html>
