---
import DocsShell from '@/layouts/DocsShell.astro'
import { getAllDocs, getCategory, getDocsInCategory, getCategories } from '@/lib/docsClient'

const LANGUAGE_CODE_RX = /^[a-z]{2}$/i

export const prerender = true

export async function getStaticPaths() {
  try {
    const [payload, categoriesRaw] = await Promise.all([
      getAllDocs(),
      getCategories(),
    ])

    const docs = Array.isArray(payload?.docs) ? payload.docs : []
    const categories = Array.isArray(categoriesRaw) ? categoriesRaw : []
    const slugByName = new Map<string, string>()

    for (const cat of categories) {
      const name = typeof cat?.name === 'string' ? cat.name : ''
      const slug = typeof cat?.slug === 'string' ? cat.slug.trim() : ''
      if (!name || !slug) {
        continue
      }
      slugByName.set(name, slug)
    }

    const seen = new Set<string>()
    const paths = []

    for (const d of docs) {
      const rawLanguage = typeof d?.language === 'string' ? d.language.trim() : ''
      if (!LANGUAGE_CODE_RX.test(rawLanguage)) {
        continue
      }
      const language = rawLanguage.toLowerCase()
      const categoryName = typeof d?.category === 'string' ? d.category : ''
      if (!language || !categoryName) {
        continue
      }
      const categorySlug = slugByName.get(categoryName)
      if (!categorySlug) {
        continue
      }
      const key = `${language}::${categorySlug}`
      if (seen.has(key)) {
        continue
      }
      seen.add(key)
      paths.push({ params: { language, category: categorySlug } })
    }

    return paths
  } catch {
    return []
  }
}

const languageParam = typeof Astro.params.language === 'string' ? Astro.params.language : ''
const categoryParam = typeof Astro.params.category === 'string' ? Astro.params.category : ''
const language = LANGUAGE_CODE_RX.test(languageParam || '') ? languageParam.toLowerCase() : 'en'
const category = categoryParam
const cat  = await getCategory(category)
const docs = await getDocsInCategory(language, category)

const ICON_PATHS = {
  book:     'M4 19.5V6.75A2.25 2.25 0 016.25 4.5h11.5m-13.75 15A2.25 2.25 0 006.25 21h11.5m-13.75-1.5h13.5m0-15A2.25 2.25 0 0121 6.75V21M6.75 7.5h6',
  users:    'M16 14a4 4 0 10-8 0m-5 6a7 7 0 0114 0M12 8a4 4 0 110-8 4 4 0 010 8',
  check:    'M4.5 12.75l6 6 9-13.5',
  beaker:   'M9 2.25h6M9 2.25v5.25L4.5 15.75A6 6 0 0010.5 21h3a6 6 0 006-5.25L15 7.5V2.25',
  calendar: 'M6 8h12M7 4v4m10-4v4M6 20h12a2 2 0 002-2V8H4v10a2 2 0 002 2',
}

const title = `${cat?.label || category} — Docs (${language}) | Ifitwala Ed`
const description = cat?.description || 'Category'
---

<DocsShell lang={language || 'en'} title={title} description={description}>
  <main class="mx-auto max-w-6xl px-6 py-10">
    <nav class="text-sm text-slate mb-4">
      <a class="hover:underline" href={`/docs/${language || 'en'}`}>Docs</a>
      <span class="mx-1">›</span>
      <span>{cat?.label || category}</span>
    </nav>

    <header class="mb-6">
      <h1 class="text-2xl font-bold flex items-center gap-2">
        {cat?.icon && (
          ICON_PATHS[(cat.icon || '').toLowerCase()]
            ? (
              <svg
                viewBox="0 0 24 24"
                class="w-6 h-6 opacity-80"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d={ICON_PATHS[(cat.icon || '').toLowerCase()]} />
              </svg>
            )
            : <span class="text-xl">{cat.icon}</span>
        )}
        <span>{cat?.label || category}</span>
      </h1>
      {cat?.description && <p class="text-slate mt-1">{cat.description}</p>}
    </header>

    {docs?.length ? (
      <ul class="grid sm:grid-cols-2 gap-4">
        {docs.map((d) => (
          <li>
            <a
              href={`/docs/${language}/${d.slug}`}
              class="block bg-white border rounded-2xl p-5 hover:shadow-lg transition"
            >
              <div class="font-semibold">{d.title}</div>
              {d.summary && <div class="text-sm text-slate mt-1">{d.summary}</div>}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <div class="text-slate">No documents in this category yet.</div>
    )}
  </main>
</DocsShell>
