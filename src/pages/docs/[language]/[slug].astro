---
import DocsLayout from '@/components/docs/DocsLayout.astro'
import DocsShell from '@/layouts/DocsShell.astro'
import { getAllDocs, getOneDoc } from '@/lib/docsClient'
import { describeLanguage } from '@/lib/language'

export const prerender = true

export async function getStaticPaths() {
  try {
    const payload = await getAllDocs()
    const docs = Array.isArray(payload?.docs) ? payload.docs : []
    const seen = new Set<string>()
    const paths = []

    for (const d of docs) {
      const { raw: languageRaw, slug: languageSlug } = describeLanguage(d?.language)
      const docSlug = typeof d?.slug === 'string' ? d.slug.trim() : ''
      if (!languageRaw || !docSlug) {
        continue
      }
      const key = `${languageSlug}::${docSlug}`
      if (seen.has(key)) {
        continue
      }
      seen.add(key)
      paths.push({
        params: { language: languageSlug, slug: docSlug },
        props: { languageRaw, languageSlug },
      })
    }

    return paths
  } catch (error) {
    console.warn('[docs][slug] getStaticPaths error:', error)
    return []
  }
}

const props = (Astro.props ?? {}) as Record<string, unknown>
const languageParam = typeof Astro.params.language === 'string' ? Astro.params.language : ''
const slugParam = typeof Astro.params.slug === 'string' ? Astro.params.slug : ''
const propLanguageRaw = typeof props.languageRaw === 'string' ? props.languageRaw : ''
const propLanguageSlug = typeof props.languageSlug === 'string' ? props.languageSlug : ''

const initialLanguage = describeLanguage(propLanguageRaw || languageParam)
const languageForApi = initialLanguage.raw || 'en'
const languageSlugParam = propLanguageSlug || initialLanguage.slug || 'en'

const slug = slugParam
let doc
try {
  doc = await getOneDoc(languageForApi, slug)
} catch {
  doc = null
}

const docLanguage = describeLanguage(doc?.language || languageForApi)
const langRaw = docLanguage.raw || languageForApi
const langSlug = docLanguage.slug || languageSlugParam
const title = doc ? `${doc.title} | Ifitwala Ed Docs` : 'Not Found | Ifitwala Ed Docs'
const description = doc?.summary || ''
const canonical = doc ? `/docs/${langSlug}/${doc.slug}` : undefined
---

<DocsShell lang={langRaw || 'en'} title={title} description={description} canonical={canonical}>
  {!doc ? (
    <main class="mx-auto max-w-3xl px-6 py-10">
      <h1 class="text-2xl font-semibold text-primary mb-2">Page not found</h1>
      <p class="text-slate mb-6">
        We couldn’t find <code class="font-mono">{slug}</code> in <strong>{langRaw || 'en'}</strong>.
      </p>
      <a class="text-primary underline" href={`/docs/${langSlug || 'en'}`}>Back to docs</a>
    </main>
  ) : (
    <DocsLayout doc={doc} />
  )}
</DocsShell>
