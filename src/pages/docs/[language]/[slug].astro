---
import DocsLayout from '@/components/docs/DocsLayout.astro'
import DocsShell from '@/layouts/DocsShell.astro'
import { getAllDocs, getOneDoc } from '@/lib/docsClient'

export async function getStaticPaths() {
  const langs = ['en', 'th', 'fr', 'ar'] // adjust to your seeded languages
  const paths = []

  for (const language of langs) {
    try {
      const { docs = [] } = await getAllDocs(language)
      for (const d of docs) {
        if (d?.slug) {
          paths.push({ params: { language, slug: d.slug } })
        }
      }
    } catch {
      // ignore languages without data
    }
  }

  return paths
}

const { language, slug } = Astro.params
let doc
try {
  doc = await getOneDoc(language, slug)
} catch {
  doc = null
}

const lang = doc?.language || language || 'en'
const title = doc ? `${doc.title} | Ifitwala Ed Docs` : 'Not Found | Ifitwala Ed Docs'
const description = doc?.summary || ''
const canonical = doc ? `/docs/${lang}/${doc.slug}` : undefined
---

<DocsShell lang={lang} title={title} description={description} canonical={canonical}>
  {!doc ? (
    <main class="mx-auto max-w-3xl px-6 py-10">
      <h1 class="text-2xl font-semibold text-primary mb-2">Page not found</h1>
      <p class="text-slate mb-6">
        We couldn’t find <code class="font-mono">{slug}</code> in <strong>{lang}</strong>.
      </p>
      <a class="text-primary underline" href={`/docs/${lang}`}>Back to docs</a>
    </main>
  ) : (
    <DocsLayout doc={doc} />
  )}
</DocsShell>
