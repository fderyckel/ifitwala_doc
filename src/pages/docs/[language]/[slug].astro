---
import DocsLayout from '@/components/docs/DocsLayout.astro'
import DocsShell from '@/layouts/DocsShell.astro'
import { getAllDocs, getOneDoc } from '@/lib/docsClient'

function normalizeLanguage(raw: unknown) {
  if (typeof raw !== 'string') {
    return ''
  }
  const trimmed = raw.trim()
  return /^[a-z]{2}$/i.test(trimmed) ? trimmed.toLowerCase() : ''
}

export const prerender = true

export async function getStaticPaths() {
  try {
    const payload = await getAllDocs()
    const docs = Array.isArray(payload?.docs) ? payload.docs : []
    const seen = new Set<string>()
    const paths = []

    for (const d of docs) {
      const language = normalizeLanguage(d?.language)
      const slug = typeof d?.slug === 'string' ? d.slug.trim() : ''
      if (!language || !slug) {
        continue
      }
      const key = `${language}::${slug}`
      if (seen.has(key)) {
        continue
      }
      seen.add(key)
      paths.push({ params: { language, slug } })
    }

    return paths
  } catch (error) {
    console.warn('[docs][slug] getStaticPaths error:', error)
    return []
  }
}

const languageParam = typeof Astro.params.language === 'string' ? Astro.params.language : ''
const slugParam = typeof Astro.params.slug === 'string' ? Astro.params.slug : ''
const language = normalizeLanguage(languageParam || '') || 'en'
const slug = slugParam
let doc
try {
  doc = await getOneDoc(language, slug)
} catch {
  doc = null
}

const lang = doc?.language || language || 'en'
const title = doc ? `${doc.title} | Ifitwala Ed Docs` : 'Not Found | Ifitwala Ed Docs'
const description = doc?.summary || ''
const canonical = doc ? `/docs/${lang}/${doc.slug}` : undefined
---

<DocsShell lang={lang} title={title} description={description} canonical={canonical}>
  {!doc ? (
    <main class="mx-auto max-w-3xl px-6 py-10">
      <h1 class="text-2xl font-semibold text-primary mb-2">Page not found</h1>
      <p class="text-slate mb-6">
        We couldn’t find <code class="font-mono">{slug}</code> in <strong>{lang}</strong>.
      </p>
      <a class="text-primary underline" href={`/docs/${lang}`}>Back to docs</a>
    </main>
  ) : (
    <DocsLayout doc={doc} />
  )}
</DocsShell>
