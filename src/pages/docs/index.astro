---
// /src/pages/docs/index.astro
import { getCategories } from '@/lib/docsClient'

// Default language = en (per your decision)
const language = 'en'
let categories = []
try {
  categories = await getCategories(language)
} catch (e) {
  categories = []
}

// Icon renderer: emoji or minimal inline SVG by key
const Icon = ({ icon }: { icon?: string }) => {
  if (!icon) return null
  const key = (icon || '').trim()
  const map: Record<string, string> = {
    book: 'M4 19.5V6.75A2.25 2.25 0 016.25 4.5h11.5M4 19.5A2.25 2.25 0 006.25 21h11.5M4 19.5h13.5m0-15a2.25 2.25 0 012.25 2.25V21M6.75 7.5h6',
    users: 'M16 14a4 4 0 10-8 0m-5 6a7 7 0 0114 0M12 8a4 4 0 110-8 4 4 0 010 8',
    check: 'M4.5 12.75l6 6 9-13.5',
    beaker:'M9 2.25h6M9 2.25v5.25L4.5 15.75A6 6 0 0010.5 21h3a6 6 0 006-5.25L15 7.5V2.25',
    calendar:'M6 8h12M7 4v4m10-4v4M6 20h12a2 2 0 002-2V8H4v10a2 2 0 002 2',
    // add more as needed
  }
  if (map[key]) {
    return (
      <svg viewBox="0 0 24 24" class="w-6 h-6 opacity-80" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" innerHTML={map[key]} />
    )
  }
  // fallback: treat as emoji/text
  return <span class="text-xl">{key}</span>
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Documentation | Ifitwala Ed</title>
    <meta name="description" content="Explore Ifitwala Ed docs by category" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>

  <body class="bg-panel text-ink">
    <main class="mx-auto max-w-6xl px-6 py-12">
      <header class="mb-10">
        <h1 class="text-3xl font-bold tracking-tight">Ifitwala Ed Documentation</h1>
        <p class="text-slate mt-2">Start by choosing a category.</p>
      </header>

      {categories?.length ? (
        <section class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {categories.map((c:any) => (
            <a
              href={`/docs/${language}/${c.slug}/`}
              class="group block bg-white border rounded-2xl p-6 hover:shadow-lg transition"
            >
              <div class="h-1 w-10 rounded bg-brand-600 mb-4 opacity-90 group-hover:opacity-100"></div>
              <div class="flex items-start gap-3">
                <Icon icon={c.icon} />
                <div>
                  <div class="text-lg font-semibold group-hover:text-brand-700">
                    {c.label}
                  </div>
                  {c.description && (
                    <p class="text-sm text-slate mt-1">{c.description}</p>
                  )}
                </div>
              </div>
            </a>
          ))}
        </section>
      ) : (
        <div class="text-slate">No categories found yet.</div>
      )}
    </main>
  </body>
</html>
