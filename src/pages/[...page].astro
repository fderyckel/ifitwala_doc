---
import SiteShell from '@/layouts/SiteShell.astro'
import { getNav, getPage, getSiteSettings, listPages } from '@/lib/siteClient'
import { resolveSectionComponent } from '@/components/site/sections'

export const prerender = true

const RESERVED_STATIC_ROUTES = new Set([
  '/book-a-call',
  '/book-a-demo',
  '/data-governance',
  '/education',
  '/ifitwala-ed',
  '/services',
  '/services/erp-implementation',
])

export async function getStaticPaths() {
  try {
    const pages = await listPages()
    return pages
      .filter((page) => {
        if (!page?.slug || page.slug === '/') {
          return false
        }
        const normalized = page.slug.replace(/\/+$/, '') || '/'
        return (
          !RESERVED_STATIC_ROUTES.has(normalized) &&
          !page.slug.startsWith('/docs') &&
          !page.slug.startsWith('/docs/')
        )
      })
      .map((page) => {
        const normalized = typeof page.slug === 'string' ? page.slug.trim() : ''
        const cleaned = normalized.replace(/^\/+/, '')
        const param = cleaned.length ? cleaned : undefined
        return {
          params: { page: param },
          props: { slug: page.slug },
        }
      })
  } catch {
    return []
  }
}

const rawParam = Astro.params.page
const slugSegments = Array.isArray(rawParam)
  ? rawParam
  : typeof rawParam === 'string' && rawParam.length
  ? rawParam.split('/')
  : []
const slug = slugSegments.length ? `/${slugSegments.join('/')}` : '/'

const [page, settings, headerNav, footerNav] = await Promise.all([
  getPage(slug),
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const sections = Array.isArray(page?.sections)
  ? [...page.sections].sort((a, b) => (a?.order ?? 0) - (b?.order ?? 0))
  : []

const pageSeo = page?.seo ?? {}
const longformSections = sections.filter((section) => section?.type === 'Longform Content')
const longformSeo =
  longformSections.length === 1 && typeof longformSections[0]?.props === 'object'
    ? longformSections[0]?.props?.seo ?? {}
    : {}

const take = (value: unknown): string => {
  if (typeof value !== 'string') return ''
  const trimmed = value.trim()
  return trimmed
}

const siteName = settings?.site_name || 'Ifitwala'

const seoTitle =
  take(pageSeo?.seo_title) ||
  take(pageSeo?.title) ||
  take(page?.title) ||
  take(longformSeo?.title) ||
  `${slugSegments.map((s) => s.replace(/-/g, ' ')).join(' · ') || 'Page'} | ${siteName}`

const mergedDescription =
  take(pageSeo?.seo_description) ||
  take(pageSeo?.description) ||
  take(pageSeo?.meta_description) ||
  take(longformSeo?.description) ||
  settings?.tagline ||
  siteName

const metaKeywords =
  take(pageSeo?.seo_keywords) ||
  take(longformSeo?.keywords) ||
  ''

const canonical =
  take(pageSeo?.canonical_url) ||
  take(longformSeo?.canonical) ||
  page?.slug ||
  slug

const ogTitle =
  take(pageSeo?.og_title) ||
  take(longformSeo?.ogTitle) ||
  seoTitle

const ogDescription =
  take(pageSeo?.og_description) ||
  take(longformSeo?.ogDescription) ||
  mergedDescription

const ogImage =
  take(pageSeo?.og_image) ||
  take(longformSeo?.ogImage) ||
  undefined

const ogImageAlt =
  take(pageSeo?.og_image_alt) ||
  take(longformSeo?.ogImageAlt) ||
  undefined

const ogType =
  take(pageSeo?.og_type) ||
  take(longformSeo?.ogType) ||
  undefined

const noindex = Boolean(pageSeo?.seo_noindex)
const nofollow = Boolean(pageSeo?.seo_nofollow)

const seoDescription = mergedDescription
const canonicalUrl = canonical

const layoutVariant = (page?.layout || 'Standard').toLowerCase()
const stackClasses =
  layoutVariant === 'landing'
    ? 'space-y-16 md:space-y-20'
    : 'space-y-12'

function sectionAnchor(label?: string | null, fallback?: string) {
  const source = label || fallback
  if (!source) return undefined
  return source
    .toString()
    .trim()
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '')
}

const hasContent = sections.length > 0 || Boolean(page?.title)
if (!hasContent) {
  Astro.response.status = 404
}
---

<SiteShell
  lang="en"
  title={seoTitle}
  description={seoDescription}
  canonical={canonicalUrl}
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
  keywords={metaKeywords}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  ogType={ogType}
  noindex={noindex}
  nofollow={nofollow}
>
  <div class={`mx-auto w-full max-w-6xl px-6 py-16 md:py-24 ${stackClasses}`}>
    {hasContent ? (
      <>
        {page?.title && (
          <header class="mb-12 text-center md:mb-16">
            <h1 class="text-3xl font-semibold tracking-tight text-ink md:text-4xl">
              {page.title}
            </h1>
            {page?.seo?.description && (
              <p class="mt-3 text-lg text-slate">{page.seo.description}</p>
            )}
          </header>
        )}

        {sections.map((section) => {
          const Component = resolveSectionComponent(section?.type)
          if (!Component) {
            return null
          }
          const id =
            sectionAnchor(section?.block?.label, section?.block?.name) ||
            sectionAnchor(section?.type)
          return <Component id={id} {...(section?.props || {})} />
        })}
      </>
    ) : (
      <section class="rounded-3xl border border-dashed border-line bg-white px-6 py-14 text-center text-slate">
        <h1 class="text-2xl font-semibold text-ink">Page not found</h1>
        <p class="mt-3 text-sm">
          The requested page is not published yet. Make sure the slug {slug} exists in your Ifitwala Web Pages.
        </p>
        <a href="/" class="mt-4 inline-flex items-center gap-2 text-primary hover:underline">
          Back to home <span aria-hidden="true">→</span>
        </a>
      </section>
    )}
  </div>
</SiteShell>
