---
import { CheckCircle2 } from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import LeadForm from '@/components/LeadForm.vue'
import { getNav, getSiteSettings } from '@/lib/siteClient'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'Book a Call | Ifitwala'
const description =
  'Book a call with Ifitwala to discuss ERP implementation, workflow improvement, data governance, education systems, or Ifitwala Ed.'

const topics = [
  'ERP implementation or cleanup',
  'Workflow and reporting problems',
  'Data governance and privacy-readiness',
  'Education systems or Ifitwala Ed',
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/book-a-call/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
>
  <section class="bg-sand/60">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Book a call</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          Bring the messy systems question.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate">
          Use this call for ERP implementation, workflow clarity, data governance, privacy-readiness, education systems, or an early conversation about Ifitwala Ed.
        </p>
        <ul class="mt-8 grid gap-3">
          {topics.map((topic) => (
            <li class="flex items-start gap-3 rounded-md bg-white p-4 text-sm text-slate shadow-soft">
              <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
              <span>{topic}</span>
            </li>
          ))}
        </ul>
      </div>

      <LeadForm
        client:load
        mode="company"
        source="Website - Book a Call"
        title="Book a Call"
        subtitle="Tell us what system, workflow, or data problem you want to discuss."
        submitLabel="Send Inquiry"
      />
    </div>
  </section>
</SiteShell>
