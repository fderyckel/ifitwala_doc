---
import { CheckCircle2 } from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import LeadForm from '@/components/LeadForm.vue'
import { getNav, getSiteSettings } from '@/lib/siteClient'
import { SEO_KEYWORDS, absoluteSiteUrl } from '@/lib/seo'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'Book an ERP Implementation Call | Ifitwala'
const description =
  'Book a 15-minute fit call with Ifitwala to discuss school ERP, ERP discovery, ERPNext, Odoo, workflow improvement, or data exposure risks.'

const structuredData = [
  {
    '@type': 'ContactPage',
    '@id': `${absoluteSiteUrl('/en/book-a-call/')}#contact`,
    name: title,
    url: absoluteSiteUrl('/en/book-a-call/'),
    description,
  },
]

const topics = [
  'Admissions, operations, or reporting spread across spreadsheets',
  'ERP discovery before a larger implementation commitment',
  'ERPNext, Frappe, or Odoo implementation questions',
  'Sensitive data access, exports, and reporting risks',
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/book-a-call/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
  keywords={SEO_KEYWORDS.join(', ')}
  structuredData={structuredData}
  availableLocales={['en', 'fr']}
>
  <section class="bg-sand/60">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Book a fit call</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          Bring the messy systems question. Leave with a clearer next step.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate">
          Use this 15-minute call to decide whether the next move is discovery, ERP implementation, a data exposure audit, or simply a better way to frame the problem.
        </p>
        <ul class="mt-8 grid gap-3">
          {topics.map((topic) => (
            <li class="flex items-start gap-3 rounded-md bg-white p-4 text-sm text-slate shadow-soft">
              <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
              <span>{topic}</span>
            </li>
          ))}
        </ul>
      </div>

      <LeadForm
        client:load
        mode="company"
        variant="compact"
        source="Website - Book a Call"
        title="Book a 15-minute fit call"
        subtitle="Three fields, two selectors, then we can decide whether there is a fit."
        submitLabel="Request fit call"
      />
    </div>
  </section>
</SiteShell>
