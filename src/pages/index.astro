---
import {
  ArrowRight,
  ClipboardList,
  Database,
  Route,
  ShieldCheck,
  Target,
} from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import SystemsMap from '@/components/site/SystemsMap.astro'
import { getNav, getSiteSettings } from '@/lib/siteClient'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'Ifitwala | ERP, data governance, and operational systems'
const description =
  'Ifitwala designs and delivers ERP-driven operational systems across Frappe, ERPNext, Odoo, education platforms, data governance, business analysis, and project delivery.'

const services = [
  {
    label: 'Business Analysis',
    href: '/services/',
    Icon: ClipboardList,
    body:
      'Clarify how work actually happens: processes, gaps, owners, dependencies, requirements, and the decisions a system must support.',
  },
  {
    label: 'ERP Implementation',
    href: '/services/erp-implementation/',
    Icon: Database,
    body:
      'Implement Frappe, ERPNext, Odoo, and related platforms with practical attention to roles, records, workflows, approvals, migration, UAT, and go-live.',
  },
  {
    label: 'Project Management',
    href: '/services/',
    Icon: Target,
    body:
      'Coordinate scope, milestones, risks, stakeholders, testing, governance, and delivery so implementation work does not drift or stall.',
  },
  {
    label: 'Data Governance',
    href: '/data-governance/',
    Icon: ShieldCheck,
    body:
      'Review where sensitive data lives, who can access it, how it moves, and which controls are needed for GDPR, PDPA, and operational accountability.',
  },
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
>
  <section class="bg-sand/60">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,1.05fr)_minmax(320px,0.95fr)] lg:items-center lg:py-24">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase text-canopy">
          ERP, data governance, and operations delivery
        </p>

        <h1 class="mt-5 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          Operational systems for organizations that have outgrown scattered work.
        </h1>

        <p class="mt-6 text-lg leading-relaxed text-slate md:text-xl">
          Ifitwala designs and delivers ERP-driven operational systems. We work across Frappe, ERPNext, Odoo, data governance, business analysis, and project delivery — with deep credibility from building Ifitwala Ed, our own education ERP for complex school operations.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/services/"
            class="inline-flex items-center gap-2 rounded-md bg-canopy px-5 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-[#0f4a31] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/60"
          >
            Explore our services
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>

          <a
            href="/ifitwala-ed/"
            class="inline-flex items-center gap-2 rounded-md border border-canopy/30 bg-white px-5 py-3 text-sm font-semibold text-canopy transition hover:border-leaf hover:text-leaf focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/60"
          >
            See Ifitwala Ed
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <SystemsMap />
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase text-canopy">
          What we do
        </p>

        <h2 class="mt-3 text-3xl font-semibold text-ink">
          From process reality to governed ERP delivery.
        </h2>

        <p class="mt-4 text-base leading-relaxed text-slate">
          Software implementation fails when the operational reality is unclear. We help organizations define the work, implement the system, manage delivery, and govern the data that runs through it.
        </p>
      </div>

      <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {services.map((item) => {
          const Icon = item.Icon
          return (
            <article class="rounded-lg border border-border bg-white p-6 shadow-soft">
              <div class="flex h-11 w-11 items-center justify-center rounded-md bg-sky text-canopy">
                <Icon class="h-5 w-5" aria-hidden="true" />
              </div>

              <h3 class="mt-5 text-lg font-semibold text-ink">
                {item.label}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-slate">
                {item.body}
              </p>

              <a
                href={item.href}
                class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-canopy hover:text-leaf"
              >
                Learn more
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="bg-sky/45">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">
          Deepest domain
        </p>

        <h2 class="mt-3 text-3xl font-semibold text-ink">
          Education is where our systems thinking was tested hardest.
        </h2>
      </div>

      <div class="space-y-5 text-base leading-relaxed text-slate">
        <p>
          Schools and education groups carry dense operational data: applicants, students, guardians, staff, attendance, assessment, finance, learning platforms, wellbeing records, and leadership reporting.
        </p>

        <p>
          That environment demands more than configuration. It requires strong permissions, clean workflows, reliable records, privacy-aware access, and reporting that leaders can trust.
        </p>

        <p>
          This gives Ifitwala a practical base for organizations outside education that face similar people-process-data complexity.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">
          Flagship product
        </p>

        <h2 class="mt-3 text-3xl font-semibold text-ink">
          Ifitwala Ed proves the work.
        </h2>

        <p class="mt-4 text-base leading-relaxed text-slate">
          Ifitwala Ed is our full education ERP, built from direct international-school experience. It is proof that we do not only advise on systems, workflows, and data governance — we build operational platforms ourselves.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="/ifitwala-ed/"
            class="inline-flex items-center gap-2 rounded-md bg-canopy px-5 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-[#0f4a31]"
          >
            Explore Ifitwala Ed
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>

          <a
            href="/book-a-demo/"
            class="inline-flex items-center gap-2 rounded-md border border-canopy/30 px-5 py-3 text-sm font-semibold text-canopy transition hover:border-leaf hover:text-leaf"
          >
            Book a demo
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div class="rounded-lg border border-border bg-sand/45 p-6">
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-md bg-white text-canopy shadow-sm">
            <Route class="h-5 w-5" aria-hidden="true" />
          </span>

          <h3 class="text-lg font-semibold text-ink">
            From school reality to ERP design
          </h3>
        </div>

        <ul class="mt-6 grid gap-3 text-sm leading-relaxed text-slate sm:grid-cols-2">
          <li class="rounded-md bg-white p-4">Admissions and enrolment workflows</li>
          <li class="rounded-md bg-white p-4">Student, guardian, and staff records</li>
          <li class="rounded-md bg-white p-4">Role-based access and permissions</li>
          <li class="rounded-md bg-white p-4">Reporting, data quality, and governance</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-canopy text-white">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-14 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold">
          Need a clearer path from operations to implementation?
        </h2>

        <p class="mt-3 text-sm leading-relaxed text-white/80">
          Bring the messy workflow, scattered data, uncertain ERP decision, or stalled implementation. We will help you identify the next practical step.
        </p>
      </div>

      <a
        href="/book-a-call/"
        class="inline-flex items-center justify-center gap-2 rounded-md bg-white px-5 py-3 text-sm font-semibold text-canopy transition hover:bg-sand"
      >
        Book a call
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>
</SiteShell>
