---
import { CheckCircle2 } from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import LeadForm from '@/components/LeadForm.vue'
import { getNav, getSiteSettings } from '@/lib/siteClient'
import { SEO_KEYWORDS, absoluteSiteUrl } from '@/lib/seo'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'Book an Ifitwala Ed Education ERP Demo'
const description =
  'Schedule a product demo of Ifitwala Ed, the education ERP for admissions, student records, portals, workflows, reporting, and school data governance.'

const structuredData = [
  {
    '@type': 'ContactPage',
    '@id': `${absoluteSiteUrl('/en/book-a-demo/')}#contact`,
    name: title,
    url: absoluteSiteUrl('/en/book-a-demo/'),
    description,
  },
]

const demoTopics = [
  'Admissions and student records',
  'Academic and staff workflows',
  'Parent, student, and staff portals',
  'Reporting, permissions, and data quality',
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/book-a-demo/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
  keywords={SEO_KEYWORDS.join(', ')}
  structuredData={structuredData}
  availableLocales={['en', 'fr']}
>
  <section class="bg-sand/60">
    <div class="mx-auto grid w-full max-w-6xl gap-12 px-6 py-16 lg:grid-cols-[minmax(0,0.95fr)_minmax(360px,1.05fr)] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Ifitwala Ed demo</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          See the education ERP in context.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate">
          Ifitwala Ed is our flagship education ERP, built from direct international-school experience. Book a product demo focused on your school workflows, data, and reporting needs.
        </p>
        <ul class="mt-8 grid gap-3">
          {demoTopics.map((topic) => (
            <li class="flex items-start gap-3 rounded-md bg-white p-4 text-sm text-slate shadow-soft">
              <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
              <span>{topic}</span>
            </li>
          ))}
        </ul>
      </div>

      <LeadForm
        client:load
        mode="ifitwala-ed"
        source="Website - Ifitwala Ed Demo"
        title="Book a Demo"
        subtitle="Tell us about your school and what you want to see."
        submitLabel="Book Demo"
      />
    </div>
  </section>
</SiteShell>
