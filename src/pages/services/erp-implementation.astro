---
import {
  ArrowRight,
  CheckCircle2,
  ClipboardList,
  Database,
  GraduationCap,
  UsersRound,
} from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import { getNav, getSiteSettings } from '@/lib/siteClient'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'Open-source ERP Implementation | Ifitwala'
const description =
  'Open-source ERP implementation for organizations using Frappe, ERPNext, Odoo, LMS platforms, and education operations systems.'

const steps = [
  {
    label: 'Workflow and data discovery',
    body: 'We map how work happens today, where handoffs break, which records matter, and which decisions need better visibility.',
    Icon: ClipboardList,
  },
  {
    label: 'ERP configuration and implementation',
    body: 'We translate operational processes into ERP structures: records, roles, permissions, approvals, dashboards, reports, and workflows.',
    Icon: Database,
  },
  {
    label: 'Migration, testing, and adoption',
    body: 'We support data migration, UAT, training, go-live preparation, and the practical routines teams need after launch.',
    Icon: UsersRound,
  },
]

const platforms = [
  'Frappe Framework custom applications',
  'ERPNext implementation',
  'Frappe HRMS, CRM, LMS, Helpdesk, and related tools',
  'Odoo implementation support',
  'Moodle implementation and LMS integration',
  'Ifitwala_Ed for schools and education organizations',
]

const focusAreas = [
  'Workflow mapping and gap analysis',
  'Configuration versus customization decisions',
  'Master data cleanup and migration planning',
  'Roles, permissions, approvals, and access control',
  'Dashboards, reports, and decision visibility',
  'UAT, training, go-live, and post-launch support',
]

const credibilityPoints = [
  'We are the creators of Ifitwala_Ed, a unified education operations platform built on the Frappe Framework.',
  'Our Frappe experience is practical and product-level: modules, workflows, portals, permissions, records, reports, dashboards, and operational processes.',
  'That product experience gives us a strong understanding of how to translate real organizational complexity into structured, usable ERP systems.',
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/services/erp-implementation/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
>
  <section class="bg-sand/60">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="max-w-3xl">
        <p class="text-sm font-semibold uppercase text-canopy">Open-source ERP Implementation</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          ERP implementation for organizations that need systems people actually use.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate">
          We help organizations implement Frappe, ERPNext, Odoo, LMS platforms, and education operations systems with a practical focus on workflows, data quality, permissions, reporting, and adoption.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/book-a-call/" class="inline-flex items-center gap-2 rounded-md bg-canopy px-5 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-[#0f4a31]">
            Discuss your implementation
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href="/services/" class="inline-flex items-center gap-2 rounded-md border border-canopy/30 bg-white px-5 py-3 text-sm font-semibold text-canopy transition hover:border-leaf hover:text-leaf">
            View all services
            <ArrowRight class="h-4 w-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="grid gap-5 md:grid-cols-3">
        {steps.map((step) => {
          const Icon = step.Icon
          return (
            <article class="rounded-lg border border-border bg-white p-6 shadow-soft">
              <div class="flex h-11 w-11 items-center justify-center rounded-md bg-sky text-canopy">
                <Icon class="h-5 w-5" aria-hidden="true" />
              </div>
              <h2 class="mt-5 text-xl font-semibold text-ink">{step.label}</h2>
              <p class="mt-3 text-sm leading-relaxed text-slate">{step.body}</p>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="bg-sand/50">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Why Ifitwala</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">
          We do not only implement Frappe. We build on it.
        </h2>
      </div>
      <div>
        <div class="rounded-xl border border-border bg-white p-6 shadow-soft">
          <div class="flex h-12 w-12 items-center justify-center rounded-md bg-sky text-canopy">
            <GraduationCap class="h-6 w-6" aria-hidden="true" />
          </div>
          <h3 class="mt-5 text-2xl font-semibold text-ink">
            Creators of Ifitwala_Ed
          </h3>
          <p class="mt-4 text-base leading-relaxed text-slate">
            Ifitwala is the creator of Ifitwala_Ed, a unified education operations platform built on the Frappe Framework. It brings school operations into one connected system across admissions, student records, family data, learning workflows, staff processes, permissions, reporting, and governance.
          </p>
          <ul class="mt-6 grid gap-3">
            {credibilityPoints.map((point) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-slate">
                <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sky/45">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Platforms</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">
          Frappe-first expertise, with practical Odoo and LMS implementation support.
        </h2>
      </div>
      <div>
        <p class="text-base leading-relaxed text-slate">
          We specialize in Frappe Framework, ERPNext, and Frappe-based systems. We also support Odoo implementation projects where organizations need strong workflow mapping, migration planning, permissions design, testing, training, and go-live coordination.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {platforms.map((platform) => (
            <li class="flex items-start gap-3 rounded-md bg-white p-4 text-sm text-slate shadow-soft">
              <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
              <span>{platform}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[0.85fr_1.15fr]">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Implementation work</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">
          The platform matters, but the implementation discipline matters more.
        </h2>
      </div>
      <div>
        <p class="text-base leading-relaxed text-slate">
          ERP projects fail when organizations treat them as software installation projects. We focus on the operational layer: what teams do, what data they trust, who is allowed to do what, and how leadership gets reliable visibility.
        </p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2">
          {focusAreas.map((area) => (
            <li class="flex items-start gap-3 rounded-md border border-border bg-sand/40 p-4 text-sm text-slate">
              <CheckCircle2 class="mt-0.5 h-4 w-4 flex-none text-canopy" aria-hidden="true" />
              <span>{area}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</SiteShell>
