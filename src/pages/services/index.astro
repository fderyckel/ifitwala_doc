---
import { ArrowRight, ClipboardList, Database, GraduationCap, ShieldCheck } from '@lucide/astro'
import SiteShell from '@/layouts/SiteShell.astro'
import SystemsMap from '@/components/site/SystemsMap.astro'
import { getNav, getSiteSettings } from '@/lib/siteClient'
import { SEO_KEYWORDS, serviceSchema } from '@/lib/seo'

export const prerender = true

const [settings, headerNav, footerNav] = await Promise.all([
  getSiteSettings(),
  getNav('Header'),
  getNav('Footer'),
])

const title = 'ERP Discovery and Implementation for SMEs | Ifitwala'
const description =
  'ERP discovery, Frappe, ERPNext and Odoo implementation, and data exposure audits for SMEs, schools, and teams handling sensitive operational data.'

const structuredData = [
  serviceSchema({
    name: 'ERP discovery, implementation, and data governance services for SMEs',
    description,
    url: '/en/services/',
    serviceType: 'ERP discovery sprint, SME ERP implementation, Frappe consulting, Odoo implementation, data exposure audit, school ERP consulting',
  }),
]

const pillars = [
  {
    label: 'ERP Discovery Sprint',
    href: '#erp-discovery-sprint',
    Icon: ClipboardList,
    body:
      'A focused first step: map the messy process, identify risk, compare ERPNext/Odoo/Frappe options, and leave with a realistic roadmap before committing to a bigger project.',
  },
  {
    label: 'ERP Implementation',
    href: '/services/erp-implementation/',
    Icon: Database,
    body:
      'Deploy ERPNext, Frappe, or Odoo around the workflows that matter most first: admissions, finance, operations, reporting, permissions, migration, testing, and go-live.',
  },
  {
    label: 'Data Exposure Audit',
    href: '/data-governance/',
    Icon: ShieldCheck,
    body:
      'Review permissions, exports, reporting access, ownership, and handling practices to find practical governance gaps around sensitive operational data.',
  },
]
---

<SiteShell
  lang="en"
  title={title}
  description={description}
  canonical="/services/"
  headerNav={headerNav}
  footerNav={footerNav}
  settings={settings}
  keywords={SEO_KEYWORDS.join(', ')}
  structuredData={structuredData}
  availableLocales={['en', 'fr']}
>
  <section class="bg-sand/60">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.9fr)] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Services</p>
        <h1 class="mt-4 text-4xl font-semibold leading-tight text-ink md:text-5xl">
          Clarity before implementation.
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate">
          Ifitwala helps schools and organizations handling sensitive data replace scattered workflows with clearer ERP, reporting, permissions, and operational control.
        </p>
      </div>
      <SystemsMap title="From messy work to controlled systems" />
    </div>
  </section>

  <section id="erp-discovery-sprint" class="bg-white scroll-mt-24">
    <div class="mx-auto w-full max-w-6xl px-6 py-16">
      <div class="mb-10 max-w-3xl">
        <p class="text-sm font-semibold uppercase text-canopy">Core offers</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">
          Start small enough to reduce risk, then implement what is proven.
        </h2>
        <p class="mt-4 text-base leading-relaxed text-slate">
          The discovery sprint is the first offer because it sells clarity, not a premature platform commitment. Full implementation follows when the workflow, data, and ownership questions are clear.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-3">
        {pillars.map((pillar) => {
          const Icon = pillar.Icon
          return (
            <article class="rounded-lg border border-border bg-white p-6 shadow-soft">
              <div class="flex h-11 w-11 items-center justify-center rounded-md bg-sky text-canopy">
                <Icon class="h-5 w-5" aria-hidden="true" />
              </div>
              <h2 class="mt-5 text-xl font-semibold text-ink">{pillar.label}</h2>
              <p class="mt-3 text-sm leading-relaxed text-slate">{pillar.body}</p>
              <a href={pillar.href} class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-canopy hover:text-leaf">
                Learn more
                <ArrowRight class="h-4 w-4" aria-hidden="true" />
              </a>
            </article>
          )
        })}
      </div>
    </div>
  </section>

  <section class="bg-sand/50">
    <div class="mx-auto grid w-full max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase text-canopy">Best first wedge</p>
        <h2 class="mt-3 text-3xl font-semibold text-ink">
          School ERP and admissions systems come first.
        </h2>
      </div>

      <div class="rounded-lg border border-border bg-white p-6 shadow-soft">
        <div class="flex items-start gap-4">
          <span class="flex h-11 w-11 flex-none items-center justify-center rounded-md bg-sky text-canopy">
            <GraduationCap class="h-5 w-5" aria-hidden="true" />
          </span>
          <div>
            <h3 class="text-xl font-semibold text-ink">Education is where the expertise is hardest to copy.</h3>
            <p class="mt-3 text-sm leading-relaxed text-slate">
              Admissions, student records, guardians, staff, safeguarding-adjacent data, reporting, finance, and access control create the kind of people-process-data complexity that Ifitwala is built to handle.
            </p>
            <a href="/education/" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-canopy hover:text-leaf">
              Explore education systems
              <ArrowRight class="h-4 w-4" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-sky/45">
    <div class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-6 py-14 md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-semibold text-ink">Not sure whether this is an ERP, data, or workflow problem?</h2>
        <p class="mt-3 text-sm leading-relaxed text-slate">
          Start with a fit call. We can separate workflow problems, data problems, platform problems, and adoption problems before recommending a path.
        </p>
      </div>
      <a href="/book-a-call/" class="inline-flex items-center justify-center gap-2 rounded-md bg-canopy px-5 py-3 text-sm font-semibold text-white shadow-soft transition hover:bg-[#0f4a31]">
        Book a 15-minute fit call
        <ArrowRight class="h-4 w-4" aria-hidden="true" />
      </a>
    </div>
  </section>
</SiteShell>
