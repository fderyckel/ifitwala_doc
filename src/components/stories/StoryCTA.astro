---
interface Link {
  label: string
  href: string
}

interface Props {
  eyebrow?: string
  title: string
  body?: string
  primary?: Link | null
  secondary?: Link | null
}

const {
  eyebrow = 'See the platform in context',
  title,
  body = '',
  primary = { label: 'Book a Demo', href: '/book-a-demo/' },
  secondary = { label: 'Explore the Platform', href: '/platform/' },
}: Props = Astro.props
---

<section class="overflow-hidden rounded-[2.15rem] border border-[rgba(22,35,49,0.08)] bg-[linear-gradient(180deg,#162331_0%,#101923_100%)] px-6 py-8 text-white shadow-strong md:px-8 md:py-10">
  <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
    <div class="max-w-2xl space-y-3">
      <span class="inline-flex rounded-full border border-white/15 bg-white/[0.06] px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-white/70">
        {eyebrow}
      </span>
      <h2 class="font-serif text-[2rem] leading-tight tracking-[-0.04em] md:text-[2.5rem]">{title}</h2>
      {body && <p class="text-sm leading-6 text-white/76 md:text-base">{body}</p>}
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {primary && (
        <a
          href={primary.href}
          class="inline-flex items-center justify-center rounded-full border border-white/10 bg-white px-5 py-2.5 text-sm font-semibold text-[#101923] transition hover:-translate-y-0.5"
        >
          {primary.label}
        </a>
      )}
      {secondary && (
        <a
          href={secondary.href}
          class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/[0.06] px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/[0.12]"
        >
          {secondary.label}
        </a>
      )}
    </div>
  </div>
</section>
