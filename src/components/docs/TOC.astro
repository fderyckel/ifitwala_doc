---
const { headings = [] } = Astro.props
const items = (Array.isArray(headings) ? headings : []).filter(
  h => h && typeof h.depth === 'number' && h.depth <= 2
)
---
{items.length > 0 && (
  <div class="rounded-2xl border bg-white p-3 text-xs shadow-sm lg:sticky lg:top-24">
    <div class="mb-2 text-[0.65rem] font-semibold uppercase tracking-wide text-slate">
      On this page
    </div>
    <ul class="space-y-1.5">
      {items.map(h => (
        <li>
          <a
            href={`#${h.slug || ''}`}
            class="block leading-snug text-slate hover:text-primary"
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </div>
)}
