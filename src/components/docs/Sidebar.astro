---
const { sidebar, activeSlug } = Astro.props
---
<nav class="bg-white border rounded-2xl p-3 shadow-sm">
{sidebar.categories.map(cat => (
<details class="group" data-cat={cat.name} open>
<summary class="flex items-center justify-between py-2 cursor-pointer select-none">
<span class="font-semibold text-neutral-800">{cat.label}</span>
</summary>
<div class="pl-2">
{cat.sections.map(sec => (
<div class="mt-2">
<div class="text-xs uppercase tracking-wide text-neutral-500 mb-1">{sec.label}</div>
<ul class="space-y-1">
{sec.docs.map(d => (
<li>
<a href={`/docs/${d.slug}`} class={`block rounded px-2 py-1 ${d.slug===activeSlug ? 'bg-brand-50 text-brand-800' : 'hover:bg-neutral-100'}`}>{d.title}</a>
</li>
))}
</ul>
</div>
))}
</div>
</details>
))}
</nav>
