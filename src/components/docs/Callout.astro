---
const { type = 'info', title } = Astro.props
const map = { info:'border-leaf/70', warning:'border-[color:rgba(214,138,40,0.6)]', tip:'border-canopy/60', note:'border-border' }
---
<div class={`border-l-4 p-3 rounded bg-sky/60 ${map[type]}`}>
{title && <div class="font-semibold mb-1">{title}</div>}
<div class="prose prose-docs max-w-none"><slot /></div>
</div>
