---
const { tabs = [] } = Astro.props
let active = 0
---
<div class="bg-white border rounded-2xl shadow-sm">
<div class="flex gap-1 border-b p-2">
{tabs.map((t,i) => (
<button class={`px-3 py-1 rounded-full text-sm ${i===active ? 'bg-brand-100 text-brand-800' : 'hover:bg-neutral-100'}`} on:click={() => active=i}>{t.label}</button>
))}
</div>
<div class="p-3">
{tabs[active]?.content}
</div>
</div>
