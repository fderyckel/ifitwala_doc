---
const { tabs = [] } = Astro.props
let active = 0
---
<div class="bg-white border rounded-2xl shadow-sm">
<div class="flex gap-1 border-b p-2">
{tabs.map((t,i) => (
<button class={`px-3 py-1 rounded-full text-sm transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf/50 ${i===active ? 'bg-moss/40 text-canopy' : 'hover:bg-sand/80'}`} on:click={() => active=i}>{t.label}</button>
))}
</div>
<div class="p-3">
{tabs[active]?.content}
</div>
</div>
