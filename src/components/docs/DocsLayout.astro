---
import DocsLayout from '@/components/docs/DocsLayout.astro'
import { getAllDocs, getOneDoc } from '@/lib/docsClient'

export async function getStaticPaths() {
  // Fetch all published docs once; let the API tell us languages.
  const { docs } = await getAllDocs();
  if (!docs?.length) return [];
  return docs.map(d => ({ params: { language: d.language, slug: d.slug } }));
}

const { language, slug } = Astro.params;
const doc = await getOneDoc(language, slug);
---

<DocsLayout doc={doc} />
