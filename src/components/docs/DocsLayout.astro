---
import { marked } from 'marked'
import { getAllDocs } from '@/lib/docsClient'
import { describeLanguage } from '@/lib/language'
import Sidebar from './Sidebar.astro'
import TOC from './TOC.astro'

const { doc } = Astro.props
const lang = doc.language || 'en'
const docSlug =
  typeof doc?.slug === 'string' ? doc.slug.trim().replace(/^\/+|\/+$/g, '') : ''
const docsLangRoot = `/docs/${lang || 'en'}`
  .replace(/\/{2,}/g, '/')
  .replace(/\/$/, '') + '/'
const canonicalDocPath = docSlug
  ? `${docsLangRoot}${docSlug}/`.replace(/\/{2,}/g, '/')
  : docsLangRoot

function normalizeShots(raw) {
  const entries = Array.isArray(raw)
    ? raw
    : raw && typeof raw === 'object'
      ? Object.entries(raw).map(([fig, value]) => ({ fig, ...(value || {}) }))
      : []

  return entries
    .filter(Boolean)
    .map((entry, index) => {
      const figId =
        String(
          entry.fig ||
            entry.anchor ||
            entry.anchor_id ||
            entry.id ||
            entry.key ||
            ''
        ).trim() || `fig_${index + 1}`

      const urls = { ...(entry.urls || {}) }
      if (
        !urls.webp &&
        entry.srcset &&
        typeof entry.srcset === 'object' &&
        !Array.isArray(entry.srcset)
      ) {
        urls.webp = entry.srcset
      }
      if (!urls.webp || typeof urls.webp !== 'object') {
        urls.webp = {}
      }
      if (!urls.original && entry.image) {
        urls.original = entry.image
      }
      if (!urls.fallback && entry.auto) {
        urls.fallback = entry.auto
      }

      return {
        ...entry,
        fig: figId,
        urls,
        display_size: (entry.display_size || 'auto').toLowerCase(),
      }
    })
}

const shots = normalizeShots(doc.screenshots)

marked.use({ headerIds: true, mangle: false })

const VITE_ENV = ((import.meta as any) || {}).env || {}
const DOCS_BASE =
  VITE_ENV.PUBLIC_DOCS_API ||
  (typeof globalThis !== 'undefined' && (globalThis as any)?.process?.env?.DOCS_API_BASE) ||
  'http://127.0.0.1:8000'

const ASSET_BASE = String(DOCS_BASE || '').replace(/\/$/, '')

const CALLOUT_COLORS = {
  info: {
    bg: 'rgba(43, 123, 187, 0.08)',
    border: 'rgba(43, 123, 187, 0.24)',
    accent: 'rgba(43, 123, 187, 0.72)',
  },
  warning: {
    bg: 'rgba(208, 135, 0, 0.08)',
    border: 'rgba(208, 135, 0, 0.24)',
    accent: 'rgba(208, 135, 0, 0.72)',
  },
  tip: {
    bg: 'rgba(41, 159, 101, 0.08)',
    border: 'rgba(41, 159, 101, 0.24)',
    accent: 'rgba(41, 159, 101, 0.72)',
  },
  note: {
    bg: 'rgba(148, 163, 184, 0.12)',
    border: 'rgba(148, 163, 184, 0.28)',
    accent: 'rgba(148, 163, 184, 0.8)',
  },
}

const ALLOWED_CALLOUT_TYPES = new Set(Object.keys(CALLOUT_COLORS))
const CALLOUT_BORDER_CLASS = {
  info: 'border-leaf/70',
  warning: 'border-[color:rgba(214,138,40,0.6)]',
  tip: 'border-canopy/60',
  note: 'border-border',
}

function figById(id) {
  return shots.find(s => (s.fig || '').toLowerCase() === (id || '').toLowerCase())
}

function escapeHtml(s) {
  return (s || '').replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))
}

function toPictureHTML(fig, explicitSize) {
  if (!fig) return ''
  const size = explicitSize && explicitSize !== 'auto' ? explicitSize : (fig.display_size || 'auto')
  const bucket = size === 'auto' ? 'medium' : size
  const webp = fig.urls?.webp || fig.srcset || {}
  const candidate =
    webp[bucket] ||
    webp.medium ||
    webp.small ||
    webp.thumb ||
    fig.urls?.original ||
    fig.urls?.fallback ||
    fig.auto ||
    fig.image ||
    ''
  const src = resolveAssetUrl(candidate)

  const alt = fig.alt || 'screenshot'
  const caption = fig.caption_md ? marked.parse(fig.caption_md) : ''
  if (!src) return ''

  return `
  <figure id="${fig.fig}">
    <picture>
      <source srcset="${src}" type="image/webp" />
      <img src="${src}" alt="${escapeHtml(alt)}" loading="lazy" />
    </picture>
    ${caption ? `<figcaption class="text-slate mt-2">${caption}</figcaption>` : ''}
  </figure>`
}

function decodeEntities(str = '') {
  let current = String(str || '')
  for (let i = 0; i < 4; i += 1) {
    const decoded = current
      .replace(/&amp;/g, '&')
      .replace(/&lt;/g, '<')
      .replace(/&gt;/g, '>')
      .replace(/&quot;/g, '"')
      .replace(/&#39;/g, "'")
    if (decoded === current) {
      return decoded
    }
    current = decoded
  }
  return current
}

function parseAttrs(str = '') {
  const attrs = {}
  const rx = /([^\s=]+)\s*=\s*("(?:[^"]*)"|'(?:[^']*)')/g
  let match
  while ((match = rx.exec(str))) {
    const key = match[1]
    const quoted = match[2]
    attrs[key] = decodeEntities(quoted.slice(1, -1))
  }
  return attrs
}

function normalizeSlug(input = '') {
  return String(input || '')
    .trim()
    .replace(/^\/+|\/+$/g, '')
    .toLowerCase()
}

function parseSlugList(raw = '') {
  const dedupe = new Set()
  for (const token of String(raw || '').split(/[,\s]+/)) {
    const slug = normalizeSlug(token)
    if (slug) {
      dedupe.add(slug)
    }
  }
  return Array.from(dedupe)
}

function extractRelatedDocRequests(md = '') {
  const requests = []
  if (!md) {
    return requests
  }

  const pushAttrs = rawAttrs => {
    const attrs = parseAttrs(decodeEntities(rawAttrs || ''))
    const slugs = parseSlugList(attrs.slugs || attrs.slug || '')
    if (!slugs.length) {
      return
    }
    requests.push({
      slugs,
      title: String(attrs.title || 'Related docs').trim() || 'Related docs',
    })
  }

  const SELF_RELATED_REGEX =
    /(?:&(?:amp;)?lt;|<)RelatedDocs\b([^>]*?)(?:\/(?:&(?:amp;)?gt;|>))/gi
  const BLOCK_RELATED_REGEX =
    /(?:&(?:amp;)?lt;|<)RelatedDocs\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/RelatedDocs(?:&(?:amp;)?gt;|>)/gi

  md.replace(SELF_RELATED_REGEX, (_, rawAttrs) => {
    pushAttrs(rawAttrs)
    return ''
  })
  md.replace(BLOCK_RELATED_REGEX, (_, rawAttrs) => {
    pushAttrs(rawAttrs)
    return ''
  })

  return requests
}

function resolveAssetUrl(input) {
  if (!input) return ''
  const trimmed = String(input || '').trim()
  if (!trimmed) return ''
  if (/^([a-z]+:)?\/\//i.test(trimmed) || trimmed.startsWith('data:')) {
    return trimmed
  }
  const normalized = trimmed.startsWith('/') ? trimmed : `/${trimmed}`
  if (!ASSET_BASE) {
    return normalized
  }
  return `${ASSET_BASE}${normalized}`
}

function applyDocTransforms(md) {
  if (!md) return ''

  // 1) Markdown image with docs://FIG  e.g.  ![alt](docs://fig-id){data-size="small"}
  md = md.replace(/!\[[^\]]*?\]\(docs:\/\/([^)]+)\)(\{[^}]*\})?/gi, (_, id, attrs) => {
    const size = (attrs || '').match(/data-size="([^"]+)"/i)?.[1]
    const fig = figById(id)
    return toPictureHTML(fig, size)
  })

  // 2) Token [[fig:fig-id size=small]]
  md = md.replace(/\[\[fig:([a-z0-9\-_]+)(?:\s+size=(large|medium|small|thumb|auto))?\]\]/gi, (_, id, size) => {
    const fig = figById(id)
    return toPictureHTML(fig, size)
  })

  // 3) AUTO_GALLERY: dump remaining figs in declared order
  if (md.includes('<!-- AUTO_GALLERY -->')) {
    const used = new Set()
    ;[/docs:\/\/([^)]+)\)/gi, /\[\[fig:([a-z0-9\-_]+)[^\]]*\]\]/gi].forEach(rx => {
      md.replace(rx, (_, id) => { used.add((id || '').toLowerCase()) })
    })
    const gallery = shots
      .filter(s => !used.has((s.fig || '').toLowerCase()))
      .map(s => toPictureHTML(s))
      .join('\n')
    md = md.replace('<!-- AUTO_GALLERY -->', gallery)
  }

  return md
}

function ensureTrailingSlash(path = '') {
  return path.endsWith('/') ? path : `${path}/`
}

function createSlugger() {
  const seen = new Map()
  return input => {
    const raw =
      typeof input === 'string'
        ? input
        : Array.isArray(input)
          ? input.join(' ')
          : (input && typeof input === 'object' && 'text' in input && typeof input.text === 'string')
            ? input.text
            : (input && typeof input === 'object' && 'raw' in input && typeof input.raw === 'string')
              ? input.raw
              : String(input ?? '')

    let base = raw
      .toLowerCase()
      .trim()
      .replace(/[^\w\s-]/g, '')
      .replace(/\s+/g, '-')
      .replace(/-+/g, '-')
      .replace(/^-+|-+$/g, '')
    if (!base) {
      base = 'section'
    }
    const count = seen.get(base) || 0
    seen.set(base, count + 1)
    return count ? `${base}-${count}` : base
  }
}

function extractHeadings(md) {
  if (!md) return []
  const tokens = marked.lexer(md)
  const slug = createSlugger()
  const out = []
  for (const token of tokens) {
    if (token.type === 'heading' && typeof token.depth === 'number' && token.depth >= 1) {
      const text = token.text || ''
      out.push({
        depth: token.depth,
        text,
        slug: slug(text),
      })
    }
  }
  return out
}

function rewriteRelativeMarkdownLinks(md) {
  if (!md) return ''
  const base = new URL(ensureTrailingSlash(canonicalDocPath || docsLangRoot), 'https://ifitwala.local')
  return md.replace(/\[([^\]]+)\]\((\.\/[^)]+)\)/g, (match, label, rel) => {
    const cleaned = (rel || '').trim()
    if (!cleaned.startsWith('./') || cleaned.startsWith('../')) {
      return match
    }
    try {
      const resolved = new URL(cleaned, base)
      let path = resolved.pathname.replace(/\/{2,}/g, '/')
      if (!/\.[a-z0-9]{2,}$/i.test(path) && !path.endsWith('/')) {
        path += '/'
      }
      const href = `${path}${resolved.search}${resolved.hash}`
      return `[${label}](${href})`
    } catch (error) {
      return match
    }
  })
}

function renderMarkdown(
  input,
  { allowCallouts = true, alreadyTransformed = false, slugger } = {}
) {
  const prepared = rewriteRelativeMarkdownLinks(input || '')
  let md = alreadyTransformed ? prepared : applyDocTransforms(prepared)
  const activeSlugger = slugger || createSlugger()

  const renderer = new marked.Renderer()

  renderer.heading = function (...args) {
    // marked v16+ passes a heading token object; older versions pass (text, level, raw).
    if (
      args[0] &&
      typeof args[0] === 'object' &&
      ('depth' in args[0] || 'tokens' in args[0])
    ) {
      const token = args[0]
      const level = Number(token.depth || 1)
      const rawText = typeof token.text === 'string' ? token.text : ''
      const innerHtml =
        this?.parser?.parseInline && Array.isArray(token.tokens)
          ? this.parser.parseInline(token.tokens)
          : escapeHtml(rawText)
      const id = activeSlugger(rawText)
      return `<h${level} id="${escapeHtml(id)}" class="doc-heading doc-heading-${level}">${innerHtml}</h${level}>`
    }

    const text = args[0]
    const level = Number(args[1] || 1)
    const raw = args[2]
    const source = typeof raw === 'string' ? raw : String(text ?? '')
    const id = activeSlugger(source)
    const label = typeof text === 'string' ? text : String(text ?? '')
    return `<h${level} id="${escapeHtml(id)}" class="doc-heading doc-heading-${level}">${label}</h${level}>`
  }

  const callouts = []
  const CALL_REGEX = /(?:&(?:amp;)?lt;|<)Callout\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/Callout(?:&(?:amp;)?gt;|>)/gi

  if (allowCallouts) {
    md = md.replace(CALL_REGEX, (_, rawAttrs, rawBody) => {
      const id = `callout-${callouts.length}`
      const placeholder = `<div data-callout-placeholder="${id}"></div>`
      callouts.push({
        id,
        attrs: parseAttrs(decodeEntities(rawAttrs || '')),
        bodyMd: (rawBody || '').trim(),
      })
      return `\n\n${placeholder}\n\n`
    })
  }

  const stepsBlocks = []
  const STEPS_REGEX =
    /(?:&(?:amp;)?lt;|<)Steps\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/Steps(?:&(?:amp;)?gt;|>)/gi
  const STEP_REGEX =
    /(?:&(?:amp;)?lt;|<)Step\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/Step(?:&(?:amp;)?gt;|>)/gi

  md = md.replace(STEPS_REGEX, (_, rawAttrs, rawBody) => {
    const id = `steps-${stepsBlocks.length}`
    const placeholder = `<div data-steps-placeholder="${id}"></div>`
    const attrs = parseAttrs(decodeEntities(rawAttrs || ''))
    const items = []
    let match
    while ((match = STEP_REGEX.exec(rawBody || ''))) {
      const stepAttrs = parseAttrs(decodeEntities(match[1] || ''))
      const bodyMd = (match[2] || '').trim()
      if (!bodyMd && !stepAttrs.title) {
        continue
      }
      items.push({
        title: String(stepAttrs.title || '').trim(),
        bodyMd,
      })
    }
    STEP_REGEX.lastIndex = 0

    stepsBlocks.push({
      id,
      title: String(attrs.title || '').trim(),
      items,
    })
    return `\n\n${placeholder}\n\n`
  })

  const doDontBlocks = []
  const DODONT_REGEX =
    /(?:&(?:amp;)?lt;|<)DoDont\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/DoDont(?:&(?:amp;)?gt;|>)/gi
  const DO_REGEX =
    /(?:&(?:amp;)?lt;|<)Do(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/Do(?:&(?:amp;)?gt;|>)/gi
  const DONT_REGEX =
    /(?:&(?:amp;)?lt;|<)Dont(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/Dont(?:&(?:amp;)?gt;|>)/gi

  md = md.replace(DODONT_REGEX, (_, rawAttrs, rawBody) => {
    const id = `dodont-${doDontBlocks.length}`
    const placeholder = `<div data-dodont-placeholder="${id}"></div>`
    const attrs = parseAttrs(decodeEntities(rawAttrs || ''))
    const dos = []
    const donts = []

    let match
    while ((match = DO_REGEX.exec(rawBody || ''))) {
      const bodyMd = (match[1] || '').trim()
      if (bodyMd) {
        dos.push(bodyMd)
      }
    }
    DO_REGEX.lastIndex = 0

    while ((match = DONT_REGEX.exec(rawBody || ''))) {
      const bodyMd = (match[1] || '').trim()
      if (bodyMd) {
        donts.push(bodyMd)
      }
    }
    DONT_REGEX.lastIndex = 0

    doDontBlocks.push({
      id,
      doTitle: String(attrs.doTitle || attrs.do_title || 'Do').trim() || 'Do',
      dontTitle: String(attrs.dontTitle || attrs.dont_title || "Don't").trim() || "Don't",
      dos,
      donts,
    })
    return `\n\n${placeholder}\n\n`
  })

  const relatedBlocks = []
  const RELATED_DOCS_SELF_REGEX =
    /(?:&(?:amp;)?lt;|<)RelatedDocs\b([^>]*?)(?:\/(?:&(?:amp;)?gt;|>))/gi
  const RELATED_DOCS_BLOCK_REGEX =
    /(?:&(?:amp;)?lt;|<)RelatedDocs\b([^>]*?)(?:&(?:amp;)?gt;|>)([\s\S]*?)(?:&(?:amp;)?lt;|<)\/RelatedDocs(?:&(?:amp;)?gt;|>)/gi

  const captureRelatedBlock = rawAttrs => {
    const id = `related-${relatedBlocks.length}`
    const placeholder = `<div data-related-placeholder="${id}"></div>`
    relatedBlocks.push({
      id,
      attrs: parseAttrs(decodeEntities(rawAttrs || '')),
    })
    return `\n\n${placeholder}\n\n`
  }

  md = md.replace(RELATED_DOCS_SELF_REGEX, (_, rawAttrs) => captureRelatedBlock(rawAttrs))
  md = md.replace(RELATED_DOCS_BLOCK_REGEX, (_, rawAttrs) => captureRelatedBlock(rawAttrs))

  let html = marked.parse(md, { renderer, mangle: false })

  for (const block of stepsBlocks) {
    const titleHtml = block.title
      ? `<div class="mb-3 text-xs font-semibold uppercase tracking-[0.24em] text-slate">${escapeHtml(block.title)}</div>`
      : ''
    const cardsHtml = block.items
      .map((item, index) => {
        const cardTitle = escapeHtml(item.title || `Step ${index + 1}`)
        const bodyHtml = renderMarkdown(item.bodyMd, {
          allowCallouts: true,
          slugger: activeSlugger,
        }).trim()
        return `<article class="rounded-2xl border border-border/70 bg-white/80 p-4 shadow-soft">
          <div class="mb-3 flex items-center gap-3">
            <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-leaf/15 text-sm font-semibold text-canopy">${index + 1}</span>
            <h3 class="m-0 text-base font-semibold text-ink">${cardTitle}</h3>
          </div>
          <div class="prose prose-docs max-w-none text-sm">${bodyHtml}</div>
        </article>`
      })
      .join('')

    const placeholder = `<div data-steps-placeholder="${block.id}"></div>`
    const stepsHtml = block.items.length
      ? `<section class="docs-steps not-prose my-8">${titleHtml}<div class="grid gap-4 md:grid-cols-2">${cardsHtml}</div></section>`
      : ''
    if (html.includes(placeholder)) {
      html = html.split(placeholder).join(stepsHtml)
    }
  }

  for (const block of doDontBlocks) {
    const renderEntries = (items, tone) => {
      if (!items.length) {
        return `<p class="text-sm text-slate">No entries yet.</p>`
      }
      return `<ul class="space-y-3">${items
        .map(item => {
          const bodyHtml = renderMarkdown(item, {
            allowCallouts: true,
            slugger: activeSlugger,
          }).trim()
          return `<li class="rounded-xl border p-3 ${
            tone === 'do'
              ? 'border-canopy/20 bg-[rgba(41,159,101,0.08)]'
              : 'border-[rgba(214,138,40,0.3)] bg-[rgba(208,135,0,0.08)]'
          }"><div class="prose prose-docs max-w-none text-sm">${bodyHtml}</div></li>`
        })
        .join('')}</ul>`
    }

    const doHtml = renderEntries(block.dos, 'do')
    const dontHtml = renderEntries(block.donts, 'dont')
    const placeholder = `<div data-dodont-placeholder="${block.id}"></div>`
    const blockHtml = `<section class="docs-do-dont not-prose my-8 grid gap-4 md:grid-cols-2">
      <article class="rounded-2xl border border-canopy/30 bg-[rgba(41,159,101,0.06)] p-4 shadow-soft">
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-canopy">${escapeHtml(block.doTitle)}</h3>
        ${doHtml}
      </article>
      <article class="rounded-2xl border border-[rgba(214,138,40,0.35)] bg-[rgba(208,135,0,0.06)] p-4 shadow-soft">
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-[0.2em] text-[rgba(166,96,23,0.95)]">${escapeHtml(block.dontTitle)}</h3>
        ${dontHtml}
      </article>
    </section>`
    if (html.includes(placeholder)) {
      html = html.split(placeholder).join(blockHtml)
    }
  }

  for (const block of relatedBlocks) {
    const slugs = parseSlugList(block.attrs.slugs || block.attrs.slug || '')
    const relatedDocs = []
    const seen = new Set()
    for (const slug of slugs) {
      if (seen.has(slug)) {
        continue
      }
      seen.add(slug)
      const item = relatedDocsLookup.get(slug)
      if (item) {
        relatedDocs.push(item)
      }
    }

    const title = String(block.attrs.title || 'Related docs').trim() || 'Related docs'
    const cards = relatedDocs
      .map(item => {
        const href = `/docs/${encodeURIComponent(item.languageSlug)}/${encodeURIComponent(item.slug)}/`
        const summary = item.summary ? `<p class="mt-2 text-sm text-slate">${escapeHtml(item.summary)}</p>` : ''
        const category = item.category
          ? `<span class="inline-flex rounded-full bg-moss/35 px-2.5 py-1 text-[0.68rem] font-medium uppercase tracking-[0.16em] text-canopy">${escapeHtml(item.category)}</span>`
          : ''
        return `<a href="${href}" class="group block rounded-2xl border border-border/70 bg-white/80 p-4 shadow-soft transition hover:shadow-strong">
          <div class="flex items-start justify-between gap-3">
            <h3 class="m-0 text-base font-semibold text-ink group-hover:text-canopy">${escapeHtml(item.title || item.slug)}</h3>
            <span class="text-lg leading-none text-leaf">-&gt;</span>
          </div>
          ${category}
          ${summary}
        </a>`
      })
      .join('')

    const emptyState =
      '<p class="rounded-xl border border-border/70 bg-white/60 p-4 text-sm text-slate">No related docs found for these slugs yet.</p>'
    const relatedHtml = `<section class="docs-related not-prose my-8 rounded-2xl border border-border/70 bg-sky/35 p-5">
      <div class="mb-4 text-xs font-semibold uppercase tracking-[0.24em] text-slate">${escapeHtml(title)}</div>
      <div class="grid gap-3 sm:grid-cols-2">${cards || emptyState}</div>
    </section>`
    const placeholder = `<div data-related-placeholder="${block.id}"></div>`
    if (html.includes(placeholder)) {
      html = html.split(placeholder).join(relatedHtml)
    }
  }

  if (allowCallouts) {
    for (const callout of callouts) {
      const typeRaw = (callout.attrs.type || 'info').toLowerCase()
      const type = ALLOWED_CALLOUT_TYPES.has(typeRaw) ? typeRaw : 'info'
      const title = callout.attrs.title || ''
      const bodyHtml = renderMarkdown(callout.bodyMd, {
        allowCallouts: true,
        slugger: activeSlugger,
      }).trim()
      const titleHtml = title ? `<div class="docs-callout-title mb-1 font-semibold">${escapeHtml(title)}</div>` : ''
      const palette = CALLOUT_COLORS[type] || CALLOUT_COLORS.info
      const borderClass = CALLOUT_BORDER_CLASS[type] || CALLOUT_BORDER_CLASS.info
      const styleAttr = ` style="--callout-bg:${palette.bg};--callout-border:${palette.border};--callout-border-strong:${palette.accent};border-color:var(--callout-border-strong);background:var(--callout-bg)"`
      const calloutHtml = `<div class="docs-callout not-prose docs-callout-${type} border-l-4 rounded p-3 ${borderClass}" data-callout-type="${type}"${styleAttr}>${titleHtml}<div class="docs-callout-body prose prose-docs max-w-none">${bodyHtml}</div></div>`
      const placeholder = `<div data-callout-placeholder="${callout.id}"></div>`
      if (html.includes(placeholder)) {
        html = html.split(placeholder).join(calloutHtml)
      }
    }
  }

  return html
}

const rawMarkdown = doc.body_md || ''
const relatedDocRequests = extractRelatedDocRequests(rawMarkdown)
const relatedDocsLookup = new Map()

if (relatedDocRequests.length) {
  try {
    const payload = await getAllDocs(lang || 'en')
    const docs = Array.isArray(payload?.docs) ? payload.docs : []
    for (const item of docs) {
      const slug = normalizeSlug(item?.slug)
      if (!slug || relatedDocsLookup.has(slug)) {
        continue
      }
      const languageInfo = describeLanguage(item?.language || lang || 'en')
      relatedDocsLookup.set(slug, {
        slug: String(item?.slug || '').trim().replace(/^\/+|\/+$/g, ''),
        title: String(item?.title || '').trim(),
        summary: String(item?.summary || '').trim(),
        category: String(item?.category_label || item?.category || '').trim(),
        languageSlug: languageInfo.slug || (lang || 'en'),
      })
    }
  } catch {
    // Fallback to an empty related-docs section if indexing fails.
  }
}

const transformedMarkdown = applyDocTransforms(rawMarkdown)
const headings = extractHeadings(transformedMarkdown)
const html = renderMarkdown(transformedMarkdown, { allowCallouts: true, alreadyTransformed: true })

function formatDateLabel(input?: string | null) {
  if (!input || typeof input !== 'string') {
    return null
  }
  const parsed = new Date(input)
  if (Number.isNaN(parsed.getTime())) {
    return null
  }
  return parsed.toLocaleDateString(undefined, {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
}

const publishedLabel = formatDateLabel(doc?.published_on)
const updatedLabel = formatDateLabel(doc?.modified)
const categorySlug = normalizeSlug(doc?.category_slug || doc?.category || '')
const categoryLabel = String(doc?.category_label || doc?.category || '').trim()
const subCategoryRaw = doc?.sub_category || doc?.subcategory || ''
const subCategorySlug = normalizeSlug(doc?.sub_category_slug || subCategoryRaw)
const subCategoryLabel = String(doc?.sub_category_label || subCategoryRaw || '').trim()
const metaItems = []
if (publishedLabel) {
  metaItems.push({ label: 'Published', value: publishedLabel })
}
if (updatedLabel) {
  metaItems.push({ label: 'Last Updated', value: updatedLabel })
}
if (doc?.author) {
  metaItems.push({ label: 'Author', value: doc.author })
}
---

<div class="mx-auto flex w-full max-w-6xl flex-col gap-10 px-6 py-10 lg:flex-row">
  <Sidebar headings={headings} />

  <main class="docs-prose prose prose-docs w-full flex-1 min-w-0 max-w-3xl lg:max-w-4xl">
    <nav class="not-prose mb-4 text-sm text-slate">
      <a href={`/docs/${lang}/`} class="hover:underline">Docs</a>
      {categorySlug && <>
        <span class="mx-1">›</span>
        <a href={`/docs/${lang}/${categorySlug}/`} class="hover:underline">
          {categoryLabel || categorySlug}
        </a>
      </>}
      {categorySlug && subCategorySlug && <>
        <span class="mx-1">›</span>
        <a href={`/docs/${lang}/${categorySlug}/${subCategorySlug}/`} class="hover:underline">
          {subCategoryLabel || subCategorySlug}
        </a>
      </>}
    </nav>

    {metaItems.length ? (
      <dl class="not-prose mb-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs font-medium uppercase tracking-[0.32em] text-slate">
        {metaItems.map(({ label, value }) => (
          <div class="flex items-center gap-2" role="presentation">
            <dt class="rounded-full bg-moss/30 px-3 py-1 text-[0.7rem] text-canopy">{label}</dt>
            <dd class="text-[0.7rem] tracking-normal normal-case text-slate">{value}</dd>
          </div>
        ))}
      </dl>
    ) : null}

    <h1 class="mb-1 font-serif text-canopy">{doc.title}</h1>
    {doc.summary && <p class="text-slate">{doc.summary}</p>}

    <div class="lg:hidden">
      <TOC headings={headings} />
    </div>

    <div class="mt-6" set:html={html} />
  </main>
</div>
