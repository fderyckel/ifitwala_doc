---
interface FeatureItem {
  order?: number
  icon?: string
  label?: string
  description?: string
  href?: string
}

interface Props {
  id?: string
  eyebrow?: string
  intro?: string
  items?: FeatureItem[]
}

const { id, eyebrow = 'Highlights', intro = '', items = [] }: Props = Astro.props
const sorted = [...items].sort((a, b) => {
  const aOrder = typeof a?.order === 'number' ? a.order : 0
  const bOrder = typeof b?.order === 'number' ? b.order : 0
  return aOrder - bOrder
})

const fallbackIconName = 'star'
const iconCache = new Map<string, any>()

function normalizeIconName(icon?: string) {
  if (typeof icon !== 'string') return ''
  const trimmed = icon.trim().toLowerCase()
  if (!trimmed) return ''
  return trimmed.replace(/[\s_]+/g, '-').replace(/-+/g, '-')
}

async function resolveLucideIcon(icon?: string) {
  const slug = normalizeIconName(icon) || fallbackIconName
  if (iconCache.has(slug)) {
    return iconCache.get(slug)
  }
  try {
    const { default: Icon } = await import(`~icons/lucide/${slug}`)
    iconCache.set(slug, Icon)
    return Icon
  } catch (_error) {
    if (slug !== fallbackIconName) {
      const fallbackIcon = await resolveLucideIcon(fallbackIconName)
      iconCache.set(slug, fallbackIcon)
      return fallbackIcon
    }
    iconCache.set(slug, null)
    return null
  }
}

const itemsWithIcons = await Promise.all(
  sorted.map(async (item) => {
    const hasIcon = typeof item?.icon === 'string' && item.icon.trim().length > 0
    const IconComponent = hasIcon ? await resolveLucideIcon(item.icon) : null
    return { ...item, IconComponent }
  })
)
---

<section
  id={id}
  class="rounded-[32px] border border-border/60 bg-white/90 px-6 py-14 shadow-lg backdrop-blur md:px-14"
>
  <header class="mx-auto max-w-3xl text-center">
    {eyebrow && (
      <p class="mx-auto inline-flex items-center justify-center rounded-full border border-leaf/40 bg-leaf/15 px-5 py-2 text-sm font-semibold uppercase tracking-[0.35em] text-canopy shadow-sm">
        {eyebrow}
      </p>
    )}
    {intro && (
      <p class="mt-4 text-lg leading-relaxed text-slate md:text-xl">
        {intro}
      </p>
    )}
  </header>

  {itemsWithIcons.length > 0 && (
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {itemsWithIcons.map((item, idx) => (
        <article
          key={idx}
          class="group flex h-full flex-col justify-between rounded-3xl border border-border/50 bg-gradient-to-br from-white to-moss/25 p-6 text-left shadow-card transition hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="flex items-start gap-5">
            {item?.IconComponent && (
              <div class="flex h-12 w-12 flex-none items-center justify-center rounded-2xl bg-leaf/20 text-canopy shadow-inner">
                <item.IconComponent class="h-6 w-6" aria-hidden="true" />
              </div>
            )}
            <div>
              <h3 class="text-lg font-semibold text-canopy">
                {item?.label || `Feature ${idx + 1}`}
              </h3>
              {item?.description && (
                <p class="mt-2 text-sm leading-relaxed text-slate">
                  {item.description}
                </p>
              )}
            </div>
          </div>
          {item?.href && (
            <a
              href={item.href}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-canopy transition hover:text-leaf"
            >
              Learn more
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
  )}
</section>
