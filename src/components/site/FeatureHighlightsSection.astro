---
interface FeatureItem {
  order?: number
  icon?: string
  label?: string
  description?: string
  href?: string
}

interface Props {
  id?: string
  eyebrow?: string
  intro?: string
  items?: FeatureItem[]
}

const { id, eyebrow = 'Highlights', intro = '', items = [] }: Props = Astro.props
const sorted = [...items].sort((a, b) => {
  const aOrder = typeof a?.order === 'number' ? a.order : 0
  const bOrder = typeof b?.order === 'number' ? b.order : 0
  return aOrder - bOrder
})
---

<section
  id={id}
  class="rounded-[32px] border border-border/60 bg-white/90 px-6 py-14 shadow-lg backdrop-blur md:px-14"
>
  <header class="mx-auto max-w-3xl text-center">
    {eyebrow && (
      <p class="text-xs font-semibold uppercase tracking-[0.35em] text-canopy">
        {eyebrow}
      </p>
    )}
    {intro && (
      <p class="mt-4 text-lg leading-relaxed text-slate md:text-xl">
        {intro}
      </p>
    )}
  </header>

  {sorted.length > 0 && (
    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {sorted.map((item, idx) => (
        <article
          key={idx}
          class="group flex h-full flex-col justify-between rounded-3xl border border-border/50 bg-gradient-to-br from-white to-moss/25 p-6 text-left shadow-card transition hover:-translate-y-1 hover:shadow-xl"
        >
          <div class="flex items-start gap-5">
            {item?.icon && (
              <div class="flex h-12 w-12 flex-none items-center justify-center rounded-2xl bg-moss/40 text-canopy shadow-inner">
                <span class="text-xl font-semibold">{item.icon}</span>
              </div>
            )}
            <div>
              <h3 class="text-lg font-semibold text-canopy">
                {item?.label || `Feature ${idx + 1}`}
              </h3>
              {item?.description && (
                <p class="mt-2 text-sm leading-relaxed text-slate">
                  {item.description}
                </p>
              )}
            </div>
          </div>
          {item?.href && (
            <a
              href={item.href}
              class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-canopy transition hover:text-leaf"
            >
              Learn more
              <span aria-hidden="true">→</span>
            </a>
          )}
        </article>
      ))}
    </div>
  )}
</section>
