---
interface Logo {
  src?: string
  alt?: string
  href?: string
  order?: number
}

interface Props {
  id?: string
  title?: string
  logos?: Logo[]
}

const { id, title = 'Trusted by schools worldwide', logos = [] }: Props = Astro.props
const visible = logos
  .filter((logo) => typeof logo?.src === 'string' && logo.src.trim().length > 0)
  .sort((a, b) => {
    const aOrder = typeof a?.order === 'number' ? a.order : 0
    const bOrder = typeof b?.order === 'number' ? b.order : 0
    return aOrder - bOrder
  })
---

<section
  id={id}
  class="rounded-[32px] border border-brand-100 bg-gradient-to-br from-white via-brand-50/40 to-white px-6 py-12 shadow-lg md:px-12"
>
  {title && (
    <h2 class="text-center text-sm font-semibold uppercase tracking-[0.3em] text-brand-600">
      {title}
    </h2>
  )}

  {visible.length > 0 && (
    <div class="mt-8 grid items-center gap-8 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
      {visible.map((logo, idx) => {
        const content = (
          <img
            src={logo.src}
            alt={logo.alt || `Partner ${idx + 1}`}
            class="mx-auto h-12 w-auto opacity-80 transition hover:opacity-100"
            loading="lazy"
          />
        )
        return (
          <div key={idx} class="flex items-center justify-center">
            {logo.href ? (
              <a href={logo.href} class="group block" target="_blank" rel="noreferrer">
                {content}
              </a>
            ) : (
              content
            )}
          </div>
        )
      })}
    </div>
  )}
</section>
